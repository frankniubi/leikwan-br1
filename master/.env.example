APP_NAME=利群會聚 LeiKwan Bridge
APP_ENV=production
APP_DEBUG=false
APP_URL=https://v3.leikwanhost.com
AGENT_API_URL=https://v3.leikwanhost.com
ARTIFACT_BASE_URL=https://v3-mirror.leikwanhost.com
APP_TIMEZONE=Asia/Shanghai
AUTO_RUN_MIGRATIONS=true

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leikwan_master
DB_USER=leikwan
DB_PASSWORD=change_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MASTER_ADMIN_TOKEN=change_me_admin_token
WHMCS_WEBHOOK_TOKEN=change_me_whmcs_webhook_token
NODE_ENROLLMENT_TOKEN=change_me_node_enrollment_token

WHMCS_BASE_URL=https://buy.leikwanhost.com
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
WHMCS_SUPPORT_DEPARTMENT_ID=

OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Identity Provider
OIDC_ISSUER_URL=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_TOKEN_AUTH_METHOD=client_secret_post
OIDC_USE_PKCE=false
OIDC_ALLOWED_SIGNING_ALGS=RS256
OIDC_CLOCK_SKEW_SECONDS=120
OIDC_REQUIRE_EMAIL_VERIFIED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=利群會聚 LeiKwan Bridge
SMTP_HELO_HOST=

DEFAULT_ENDPOINT_COUNT=1
DEFAULT_CLIENT_MODE=single
DEFAULT_TRANSPORT_MODE=tcp
DEFAULT_NODE_GROUP=default
DEFAULT_CDN_HOST=edge.example.com
DEFAULT_EDGE_PUBLIC_PORT=443
EDGE_PORT_STRATEGY=shared_preferred_port
EDGE_PATH_STRATEGY=random
# Legacy fallback only. New bond forwards should set per-forward sidecar host/port.
BOND_AGGREGATOR_HOST=
BOND_AGGREGATOR_PORT=
BOND_DEFAULT_REMOTE_PORT=9000
BOND_TOKEN_SECRET=
BOND_TOKEN_TTL_SECONDS=604800
BOND_CHUNK_SIZE=131072
BOND_MAX_WINDOW_BYTES=16777216
BOND_RETRANSMIT_MS=300
BOND_CONNECT_TIMEOUT_MS=3000
BOND_JOIN_TIMEOUT_MS=400
BOND_ACTIVE_LEG_LIMIT=0
# MPTCP tuning (applies to mptcp-mode forwards)
MPTCP_SCHEDULER=default
MPTCP_STALE_LOSS_CNT=2
MPTCP_INITCWND=80
MPTCP_INITRWND=80
MPTCP_CONNECT_TIMEOUT_MS=3000
MPTCP_ADD_ADDR_TIMEOUT=5
MPTCP_TCP_WMEM_MAX=16777216
MPTCP_TCP_RMEM_MAX=16777216
MPTCP_SOCKET_BUFFER_BYTES=8388608
MPTCP_TCP_CONGESTION_CONTROL=bbr
DEFAULT_TLS_CERT_REF=default-edge-cert
PANEL_CERTBOT_BASE_DIR=
PANEL_CERTBOT_CONFIG_DIR=
PANEL_CERTBOT_WORK_DIR=
PANEL_CERTBOT_LOGS_DIR=

MAX_TASK_BATCH=20
NODE_HEARTBEAT_TTL_SECONDS=90
