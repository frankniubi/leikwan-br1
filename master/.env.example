APP_NAME=利群會聚 LeiKwan Bridge
APP_ENV=production
APP_DEBUG=false
APP_URL=https://v3.leikwanhost.com
AGENT_API_URL=https://v3.leikwanhost.com
ARTIFACT_BASE_URL=https://v3-mirror.leikwanhost.com
APP_TIMEZONE=Asia/Shanghai
AUTO_RUN_MIGRATIONS=true
TRUSTED_PROXY_CIDRS=

ANDROID_ATTESTATION_PACKAGE_NAME=com.leikwan.bridge
ANDROID_ATTESTATION_SIGNING_CERT_SHA256=
ANDROID_ATTESTATION_ROOT_CERT_SHA256=

# OpenWrt router onboarding. While this is false the router pairing endpoint
# answers openwrt_pairing_unavailable and no pairing codes can be issued.
OPENWRT_PAIRING_ENABLED=false

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leikwan_master
DB_USER=leikwan
DB_PASSWORD=change_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MASTER_ADMIN_TOKEN=change_me_admin_token
INSTALLER_ACCESS_TOKEN=
WHMCS_WEBHOOK_TOKEN=change_me_whmcs_webhook_token
NODE_ENROLLMENT_TOKEN=change_me_node_enrollment_token

WHMCS_BASE_URL=https://buy.leikwanhost.com
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
WHMCS_SUPPORT_DEPARTMENT_ID=

OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Identity Provider
OIDC_ISSUER_URL=
OIDC_DISCOVERY_URL=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_TOKEN_AUTH_METHOD=client_secret_post
OIDC_USE_PKCE=false
OIDC_ALLOWED_SIGNING_ALGS=RS256
OIDC_CLOCK_SKEW_SECONDS=120
OIDC_REQUIRE_EMAIL_VERIFIED=true
# Optional comma-separated host:port:IPv4 mappings for server-local OIDC calls.
OIDC_PROVIDER_RESOLVE=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=利群會聚 LeiKwan Bridge
SMTP_HELO_HOST=

DEFAULT_ENDPOINT_COUNT=1
DEFAULT_CLIENT_MODE=single
DEFAULT_TRANSPORT_MODE=tcp
DEFAULT_NODE_GROUP=default
DEFAULT_CDN_HOST=edge.example.com
DEFAULT_EDGE_PUBLIC_PORT=443
# Ultra external UoT is on by default for new Ultra combinations.  The map is
# JSON keyed by ultra_destination_zone; the scalar target is the final fallback.
EXTERNAL_UOT_DEFAULT_ENABLED=true
EXTERNAL_UOT_DEFAULT_TARGET=185.220.238.143:7443
EXTERNAL_UOT_DEFAULT_TARGETS_JSON={"hong-kong":"70.36.96.183:7443","singapore":"77.93.90.45:7443","south-korea":"103.246.219.39:7443","frankfurt":"157.228.138.23:7443","moscow":"157.228.138.23:7443","taiwan":"103.246.219.39:7443","los-angeles":"208.122.17.50:7443","tokyo":"185.220.238.143:7443","china-mainland":"70.36.96.183:7443"}
USER_FORWARD_LIMIT_PER_SERVICE=64
USER_FORWARD_STORED_LIMIT_PER_SERVICE=512
EDGE_PORT_STRATEGY=shared_preferred_port
EDGE_PATH_STRATEGY=random
# Legacy fallback only. New bond forwards should set per-forward sidecar host/port.
BOND_AGGREGATOR_HOST=
BOND_AGGREGATOR_PORT=
BOND_DEFAULT_REMOTE_PORT=9000
BOND_TOKEN_SECRET=
BOND_TOKEN_TTL_SECONDS=604800
BOND_CHUNK_SIZE=131072
BOND_MAX_WINDOW_BYTES=16777216
BOND_RETRANSMIT_MS=300
BOND_CONNECT_TIMEOUT_MS=3000
BOND_JOIN_TIMEOUT_MS=400
BOND_ACTIVE_LEG_LIMIT=0
# Comma-separated sidecar point IDs that use one point-level WG listener with one peer per slave.
STATIC_SIDECAR_SHARED_WG_POINT_IDS=
# MPTCP tuning (applies to mptcp-mode forwards)
MPTCP_SCHEDULER=default
MPTCP_STALE_LOSS_CNT=2
MPTCP_INITCWND=80
MPTCP_INITRWND=80
MPTCP_CONNECT_TIMEOUT_MS=3000
MPTCP_ADD_ADDR_TIMEOUT=5
MPTCP_TCP_WMEM_MAX=16777216
MPTCP_TCP_RMEM_MAX=16777216
MPTCP_SOCKET_BUFFER_BYTES=8388608
MPTCP_TCP_CONGESTION_CONTROL=bbr
DEFAULT_TLS_CERT_REF=default-edge-cert
PANEL_CERTBOT_BASE_DIR=
PANEL_CERTBOT_CONFIG_DIR=
PANEL_CERTBOT_WORK_DIR=
PANEL_CERTBOT_LOGS_DIR=

# Ultra is integrated into this Panel API. The source identity is used only by
# an outbound material collector; it is never advertised as a traffic endpoint.
ULTRA_SOURCE_ID=
ULTRA_SOURCE_AUTH_TOKEN=
# 32 random bytes in hex or base64. Used for encrypted material and scoped
# client/forward tokens. Never distribute this key to clients or source nodes.
ULTRA_TOKEN_KEY=
# Backward-compatible cache-key alias. New installs should set ULTRA_TOKEN_KEY.
ULTRA_CACHE_KEY=
ULTRA_MAX_TTL_SECONDS=1800
ULTRA_REFRESH_SKEW_SECONDS=600
ULTRA_MATERIAL_MAX_TTL_SECONDS=2100
# Seconds before material expiry at which a line is handed back to the source
# agent for re-acquisition (default 600). Keep it below the source agent's
# material_lifetime_seconds minus its poll interval, or every poll re-acquires
# every line. Capped at ULTRA_MATERIAL_MAX_TTL_SECONDS - 300.
ULTRA_MATERIAL_REFRESH_WINDOW_SECONDS=600
# Offline-capable ("long") policy-v2 grants. Inert until a client sends
# X-Leikwan-Ultra-Offline-Validity: <300..3600> on the config pull / lease
# request; without the header grants and leases stay on the short path
# (<= 300 s, renew_after = expiry - 60). With it:
#   validity V = min(header, ULTRA_OFFLINE_VALIDITY_SECONDS, material expiry,
#                    service expiry)
#   renew_after = issue + ULTRA_RENEW_INTERVAL_SECONDS (clamped 30..V-60)
#   lease expires_at = min(policy expires_at, now + V)
# ULTRA_OFFLINE_VALIDITY_SECONDS: default 1800, clamped 300..3600; 0 turns long
# grants off for every client (header ignored).
ULTRA_OFFLINE_VALIDITY_SECONDS=1800
ULTRA_RENEW_INTERVAL_SECONDS=240
# A long grant carries min(remaining quota, slice) instead of the full remaining
# quota, so an offline device can overspend by at most one slice. Default slice:
# max(1 GiB, rate_limit * V) for a rate-limited forward, 10 GiB otherwise; never
# below two renewal intervals at the forward's rate (an unlimited forward is
# assumed to run at ULTRA_GRANT_QUOTA_UNLIMITED_RATE_MBPS, default 1000, which
# makes the unlimited default ~56 GiB). Empty = computed default.
ULTRA_GRANT_QUOTA_SLICE_ENABLED=1
ULTRA_GRANT_QUOTA_SLICE_BYTES=
ULTRA_GRANT_QUOTA_UNLIMITED_RATE_MBPS=1000
# To make V the full 1800 s instead of whatever material lifetime is left:
# ULTRA_MATERIAL_MAX_TTL_SECONDS=3900 first, then source agent
# material_lifetime_seconds=3600, then ULTRA_MATERIAL_REFRESH_WINDOW_SECONDS=2000.
# Comma separated hex build fingerprints of released ultra runtime builds.
# Empty (default) = no baseline: attestation is reported as "unknown" and never
# denies a lease. Populate it to see "mismatch" for repackaged clients.
ULTRA_RUNTIME_FINGERPRINTS=
# Abuse limits. 0 (default) = unlimited, i.e. today's behaviour. When set, an
# over-limit lease is refused with its own error code and recorded in
# ultra_lease_refusals (admin -> Ultra -> Refusals).
ULTRA_MAX_DEVICES_PER_CLIENT=0
ULTRA_MAX_LIVE_LEASES_PER_DEVICE=0
ULTRA_LEASE_ISSUE_RATE_PER_MINUTE=0

MAX_TASK_BATCH=20
NODE_HEARTBEAT_TTL_SECONDS=90

# Geographic lock and province/city/country access rules need clients that
# answer the location check. Leave off until released clients support it;
# while off the admin panel cannot enable either.
ACCESS_POLICY_LOCATION_CLIENTS_READY=0
