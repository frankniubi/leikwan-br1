# Pin the fleet-served slave agent + its downloadable artifact to LF so the
# versions.json sha256 is deterministic across checkouts/OSes. Without this a
# Windows (CRLF) checkout hashes differently from the committed LF blob, so the
# manifest sha mismatches what a clean checkout / Linux deploy serves and the
# fleet auto-update sha-check fails (see docs panel-artifact-serving notes).
/slave-agent/slave_agent.py text eol=lf
/artifacts/slave-agent.py text eol=lf
/sidecar-agent/sidecar_agent.py text eol=lf
/client-agent/client_agent.py text eol=lf
/client-agent/leikwan_mptcp_client.py text eol=lf
/artifacts/leikwan-mptcp-client.py text eol=lf

# Same reasoning for stylesheets: the legacy skin is frozen by sha256 in
# skin_v2_legacy_freeze_test.php. A checkout with core.autocrlf=true would hash
# CRLF bytes and fail the freeze with a mismatch that is not evidence of an edit.
*.css text eol=lf
