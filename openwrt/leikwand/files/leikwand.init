#!/bin/sh /etc/rc.common
# Leikwan convergence agent.
#
# procd owns the daemon; the daemon owns the forwarding runtimes it supervises.
# Keeping ownership one level deep is deliberate: a procd restart of leikwand
# must not orphan a runtime that is still holding a customer port.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/leikwand

start_service() {
	config_load leikwan
	local enabled
	config_get_bool enabled main enabled 1
	if [ "$enabled" = "0" ]; then
		logger -t leikwand "disabled by /etc/config/leikwan"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG" run
	# Give up after 5 crashes in 3600s rather than spinning on a bad config.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_set_param file /etc/config/leikwan
	procd_close_instance
}

stop_service() {
	# Removing the control socket keeps a stale token from surviving a stop.
	rm -f /var/run/leikwand/ctl.sock /var/run/leikwand/ctl.token
}

reload_service() {
	# Re-read UCI without dropping live sessions.
	"$PROG" ctl reload >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger "leikwan"
}
