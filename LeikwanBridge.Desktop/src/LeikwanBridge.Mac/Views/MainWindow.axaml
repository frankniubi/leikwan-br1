<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LeikwanBridge.Mac.ViewModels"
        xmlns:services="using:LeikwanBridge.Mac.Services"
        xmlns:views="using:LeikwanBridge.Mac.Views"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="LeikwanBridge.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource AppName}"
        Icon="avares://LeikwanBridge.Mac/Assets/app-icon.png"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="228,*" Background="{DynamicResource WindowSurfaceBrush}">

    <!-- ============ Sidebar ============ -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
      <Grid Margin="14,22,14,16" RowDefinitions="Auto,24,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryContainerBrush}" Padding="5">
            <Image Source="avares://LeikwanBridge.Mac/Assets/app-icon.png" Stretch="Uniform" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="{DynamicResource AppName}" FontSize="15" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" IsVisible="{Binding IsShellVisible}">
          <Button Classes="nav" Classes.selected="{Binding IsDashboardSelected}" Command="{Binding ShowDashboardCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <lucide:LucideIcon Kind="LayoutDashboard" Size="18" />
              <TextBlock Text="{DynamicResource DashboardLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsServicesSelected}" Command="{Binding ShowConnectionsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <lucide:LucideIcon Kind="Layers" Size="18" />
              <TextBlock Text="{DynamicResource NavServices}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsNodesSelected}" Command="{Binding ShowNodesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <lucide:LucideIcon Kind="Server" Size="18" />
              <TextBlock Text="{DynamicResource NavNodes}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsSelected}" Command="{Binding ShowSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <lucide:LucideIcon Kind="Settings" Size="18" />
              <TextBlock Text="{DynamicResource SettingsLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="10">
          <Button Classes="nav" Classes.selected="{Binding IsLogsSelected}" Command="{Binding ShowLogsCommand}"
                  IsVisible="{Binding IsShellVisible}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <lucide:LucideIcon Kind="ScrollText" Size="18" />
              <TextBlock Text="{DynamicResource LogsLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Classes="card" Padding="12,10" IsVisible="{Binding IsSignedIn}">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding ActiveClientName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SignedInUsername}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <!-- Version and update check, always visible. -->
          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6"
                  CornerRadius="12" Command="{Binding CheckForUpdatesFromSidebarCommand}"
                  AutomationProperties.Name="{DynamicResource CheckForUpdates}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="0">
                <TextBlock Text="{Binding VersionLabel}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                      Background="{DynamicResource PrimaryBrush}" IsVisible="{Binding HasUpdateAttention}" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Content ============ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0">
        <!-- Device limit: not dismissible; clears when a config pull is admitted again. -->
        <Border Classes="banner" IsVisible="{Binding IsDeviceLimitVisible}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <lucide:LucideIcon Kind="CircleAlert" Size="19" Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding DeviceLimitMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
          </Grid>
        </Border>
        <Border Classes="banner" IsVisible="{Binding IsNoticeVisible}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <lucide:LucideIcon Kind="Info" Size="19" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon ghost" Command="{Binding DismissNoticeCommand}" ToolTip.Tip="{DynamicResource DismissNotice}">
              <lucide:LucideIcon Kind="X" Size="17" />
            </Button>
          </Grid>
        </Border>
        <!-- Update available / failed: surfaced at the top of every page. -->
        <Border Classes="card" Margin="24,12,24,0" Padding="16,10" Background="{DynamicResource PrimaryContainerBrush}"
                IsVisible="{Binding IsUpdateBannerVisible}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <lucide:LucideIcon Kind="Download" Size="20" Foreground="{DynamicResource OnPrimaryContainerBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource UpdateAvailable}" FontWeight="SemiBold" Foreground="{DynamicResource OnPrimaryContainerBrush}" IsVisible="{Binding IsUpdateVisible}" />
              <TextBlock Text="{Binding UpdateReadyText}" Foreground="{DynamicResource OnPrimaryContainerBrush}" IsVisible="{Binding IsUpdateVisible}" />
              <TextBlock Text="{DynamicResource UpdateFailed}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding ShowUpdateError}" />
              <TextBlock Text="{Binding UpdateErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource OnPrimaryContainerBrush}" IsVisible="{Binding ShowUpdateError}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsUpdateInProgress}">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdatePercent}" Width="160" />
                <TextBlock Text="{Binding UpdatePhaseText}" Foreground="{DynamicResource OnPrimaryContainerBrush}" />
              </StackPanel>
              <TextBlock Text="{Binding UpdateProgressMessage}" TextWrapping="Wrap" Foreground="{DynamicResource OnPrimaryContainerBrush}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding IsUpdateVisible}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <lucide:LucideIcon Kind="Download" Size="16" />
                <TextBlock Text="{DynamicResource InstallAndRestart}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="primary" Command="{Binding RetryUpdateCommand}" IsVisible="{Binding ShowUpdateError}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <lucide:LucideIcon Kind="RefreshCw" Size="16" />
                <TextBlock Text="{DynamicResource Retry}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="icon ghost" Command="{Binding DismissUpdateCommand}" ToolTip.Tip="{DynamicResource DismissUpdate}">
              <lucide:LucideIcon Kind="X" Size="17" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <!-- ============ Sign in ============ -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLoginVisible}">
          <Grid Margin="42,28" MinHeight="560">
            <Border Classes="card" Width="480" Padding="36" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel Spacing="12">
                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource PrimaryContainerBrush}"
                        Padding="8" HorizontalAlignment="Left">
                  <Image Source="avares://LeikwanBridge.Mac/Assets/app-icon.png" Stretch="Uniform" />
                </Border>
                <TextBlock Classes="heading" Text="{DynamicResource SignInTitle}" Margin="0,5,0,0" />

                <TextBlock Classes="label" Text="{DynamicResource ConnectionSiteLabel}" Margin="0,12,0,0" />
                <ComboBox ItemsSource="{Binding PanelEndpointOptions}" HorizontalAlignment="Stretch"
                          SelectedItem="{Binding SelectedPanelEndpoint, Mode=TwoWay}"
                          AutomationProperties.Name="{DynamicResource ConnectionSiteName}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Key, Converter={StaticResource Localize}, ConverterParameter=Endpoint}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="muted" Text="{Binding PanelEndpointPrompt}" FontSize="11" TextWrapping="Wrap" />

                <!-- Ethernet binding: applied before any sign-in request; same
                     PreferredEgressInterface as the settings page. -->
                <TextBlock Classes="label" Text="{DynamicResource EgressBindingLabel}" Margin="0,4,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding EgressInterfaceOptions}"
                            SelectedValue="{Binding PreferredEgressInterface, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Id}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{DynamicResource EthernetBindingName}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding CompactLabel}" ToolTip.Tip="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="icon secondary" Command="{Binding RefreshEgressInterfacesCommand}"
                          ToolTip.Tip="{DynamicResource EgressBindingRefresh}"
                          AutomationProperties.Name="{DynamicResource EgressBindingRefresh}">
                    <lucide:LucideIcon Kind="RefreshCw" Size="16" />
                  </Button>
                </Grid>
                <TextBlock Classes="muted" Text="{DynamicResource EgressBindingHint}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EgressInterfaceNotice}" IsVisible="{Binding IsEgressInterfaceNoticeVisible}"
                           Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" />

                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="{DynamicResource ClientIdLabel}" />
                  <TextBox Text="{Binding ClientIdText, Mode=TwoWay}" Watermark="27" />
                  <TextBlock Classes="label" Text="{DynamicResource ClientTokenLabel}" />
                  <TextBox Text="{Binding AgentToken, Mode=TwoWay}" PasswordChar="*" Watermark="{DynamicResource ClientTokenWatermark}" />
                </StackPanel>

                <CheckBox Content="{DynamicResource RememberLogin}" IsChecked="{Binding RememberLoginInfo, Mode=TwoWay}" />

                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" MinHeight="22" Margin="0,4,0,0" />
                <Button Classes="primary" Command="{Binding LoginCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" MinHeight="44" Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <lucide:LucideIcon Kind="LogIn" Size="18" />
                    <TextBlock Text="{DynamicResource SignIn}" />
                  </StackPanel>
                </Button>
                <TextBlock Text="{Binding VersionLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>

        <!-- ============ Client picker ============ -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsClientPickerVisible}">
          <StackPanel Margin="48" MaxWidth="720" HorizontalAlignment="Center" Spacing="18">
            <StackPanel Spacing="5">
              <TextBlock Classes="heading" Text="{DynamicResource ChooseClientTitle}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Clients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="tonal" Margin="0,0,0,8" Padding="18,14" CornerRadius="16"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnClientClick">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <lucide:LucideIcon Kind="Monitor" Size="20" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <lucide:LucideIcon Grid.Column="2" Kind="ChevronRight" Size="18" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ Nodes section header: node library / route pairing tabs ============ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="32,28,32,18" IsVisible="{Binding IsNodesSectionVisible}">
          <StackPanel Spacing="2">
            <TextBlock Classes="heading" Text="{DynamicResource NavNodes}" />
          </StackPanel>
          <Border Grid.Column="1" Classes="surface" Padding="4" CornerRadius="21" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="tab" Classes.selected="{Binding IsNodesVisible}" Command="{Binding ShowNodesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <lucide:LucideIcon Kind="Server" Size="15" />
                  <TextBlock Text="{DynamicResource NavNodes}" />
                </StackPanel>
              </Button>
              <Button Classes="tab" Classes.selected="{Binding IsPairingVisible}" Command="{Binding ShowPairingCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <lucide:LucideIcon Kind="GitBranch" Size="15" />
                  <TextBlock Text="{DynamicResource NodesTabPairing}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ============ Dashboard ============ -->
        <views:DashboardView Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsDashboardVisible}" />

        <!-- ============ Nodes (library + cloud) ============ -->
        <views:NodesView Grid.Row="1" IsVisible="{Binding IsNodesVisible}" />

        <!-- ============ Services (代理) and 线路配对 share one workspace ============ -->
        <Grid Grid.Row="1" IsVisible="{Binding IsConnectionWorkspaceVisible}" RowDefinitions="Auto,*" Margin="32,0,32,0">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,28,0,18" IsVisible="{Binding IsConnectionsVisible}">
            <StackPanel Spacing="2">
              <TextBlock Classes="heading" Text="{DynamicResource NavServices}" />
              <TextBlock Classes="muted" Text="{Binding ServiceForwardSummary}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="icon ghost" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="{DynamicResource RefreshConnection}">
              <lucide:LucideIcon Kind="RefreshCw" Size="18" />
            </Button>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Border Grid.Column="1" Classes="card" Padding="14" Width="272" Margin="16,0,0,96"
                    IsVisible="{Binding IsPairingVisible}">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource SavedNodes}" Classes="title" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="icon tonal" Command="{Binding NewConnectionProfileCommand}" ToolTip.Tip="{DynamicResource NewNode}">
                    <lucide:LucideIcon Kind="Plus" Size="17" />
                  </Button>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding ConnectionProfiles}"
                         SelectedItem="{Binding SelectedConnectionProfile, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="services:MacConnectionProfile">
                      <StackPanel Spacing="2" Margin="4,6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DisplayProtocol}" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <ScrollViewer Grid.Column="0">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16" Margin="0,0,0,96">

                <!-- Services: assigned forwards with per-forward start / stop. -->
                <Border Grid.Row="0" Classes="card" IsVisible="{Binding IsConnectionsVisible}">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <lucide:LucideIcon Kind="Layers" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
                      <TextBlock Text="{DynamicResource AssignedForwards}" Classes="title" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{DynamicResource NoSupportedForwards}" IsVisible="{Binding !HasForwards}" />
                    <ItemsControl ItemsSource="{Binding Forwards}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ForwardRowViewModel">
                          <Border Classes="inset" Margin="0,0,0,8" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto,150,96,84" ColumnSpacing="14">
                              <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <!-- Native outbound rules ship configuration only: no start/stop control. -->
                                <TextBlock Text="{DynamicResource ForwardNativeOutboundRule}" FontWeight="SemiBold"
                                           FontSize="11" Foreground="{DynamicResource PrimaryBrush}"
                                           IsVisible="{Binding IsNativeOutboundRule}" />
                                <TextBlock Text="{Binding SavedNodeName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Border Grid.Column="1" Classes="chip">
                                <TextBlock Text="{Binding Mode}" />
                              </Border>
                              <TextBlock Grid.Column="2" Text="{Binding PortText}" Classes="mono muted" FontSize="12" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Classes="status-dot" Classes.running="{Binding IsRunning}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" />
                              </StackPanel>
                              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Classes="icon primary" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" ToolTip.Tip="{DynamicResource StartForward}">
                                  <lucide:LucideIcon Kind="Play" Size="16" />
                                </Button>
                                <Button Classes="icon danger" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" ToolTip.Tip="{DynamicResource StopForward}">
                                  <lucide:LucideIcon Kind="Square" Size="15" />
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Services: local connection through a paired route (system proxy or TUN). -->
                <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsConnectionsVisible}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <lucide:LucideIcon Kind="Waypoints" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{DynamicResource LocalConnection}" Classes="title" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="status-pill" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Width="8" Height="8" CornerRadius="4" Classes="status-dot" Classes.running="{Binding IsLocalConnectionActive}" />
                          <TextBlock Text="{Binding LocalConnectionStatusText}" FontSize="12" />
                        </StackPanel>
                      </Border>
                      <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Classes="primary" Command="{Binding StartConnectionCommand}" IsVisible="{Binding !IsLocalConnectionActive}"
                                IsEnabled="{Binding CanStartLocalConnection}">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <lucide:LucideIcon Kind="Play" Size="16" />
                            <TextBlock Text="{DynamicResource Start}" />
                          </StackPanel>
                        </Button>
                        <Button Classes="danger" Command="{Binding StopConnectionCommand}" IsVisible="{Binding IsLocalConnectionActive}">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <lucide:LucideIcon Kind="Square" Size="16" />
                            <TextBlock Text="{DynamicResource Stop}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,220" ColumnSpacing="12" Margin="0,4,0,0">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="label" Text="{DynamicResource RouteFieldLabel}" />
                        <ComboBox ItemsSource="{Binding PairedConnectionRoutes}" HorizontalAlignment="Stretch"
                                  SelectedItem="{Binding SelectedConnectionForward, Mode=TwoWay}"
                                  PlaceholderText="{DynamicResource RoutePlaceholder}" MinHeight="40">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ForwardRowViewModel">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PortText}" Classes="muted" FontSize="11" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Classes="label" Text="{DynamicResource ConnectionModeLabel}" />
                        <ComboBox ItemsSource="{Binding ConnectionModes}" HorizontalAlignment="Stretch"
                                  SelectedItem="{Binding SelectedConnectionMode, Mode=TwoWay}"
                                  PlaceholderText="{DynamicResource ConnectionModePlaceholder}" MinHeight="40">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Converter={StaticResource Localize}, ConverterParameter=Mode}" />
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SelectedConnectionEndpoint}" Classes="muted mono" FontSize="11" />
                    <TextBlock Text="{Binding BypassEntriesText}" Classes="muted" FontSize="11" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource ExternalToolHint}" />
                    <TextBlock Text="{Binding LocalConnectionError}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" MinHeight="20" />
                  </StackPanel>
                </Border>

                <!-- Services: optional native outbound from the active plan. -->
                <Panel Grid.Row="2" IsVisible="{Binding IsConnectionsVisible}">
                <Border Classes="surface" IsVisible="{Binding IsNativeOutboundVisible}">
                  <Expander IsExpanded="{Binding IsNativeOutboundExpanded, Mode=TwoWay}"
                            IsVisible="{Binding IsNativeOutboundVisible}"
                            AutomationProperties.Name="{DynamicResource NativeOutboundName}">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="4,10">
                        <lucide:LucideIcon Kind="Globe" Size="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{DynamicResource NativeOutbound}" Classes="title" />
                        </StackPanel>
                      </Grid>
                    </Expander.Header>
                    <Border Padding="4,0,4,8">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="5">
                            <TextBlock Classes="label" Text="{DynamicResource CarrierForwardLabel}" />
                            <ComboBox ItemsSource="{Binding NativeOutboundForwards}" HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding SelectedNativeForward, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Direction}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="{DynamicResource ForwardNumberPrefix}" Classes="muted" FontSize="11" />
                                      <TextBlock Text="{Binding ForwardId}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                  </StackPanel>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding IsNativeRouteScopeSelectable}">
                            <TextBlock Classes="label" Text="{DynamicResource TrafficScopeLabel}" />
                            <ComboBox ItemsSource="{Binding NativeRouteScopeOptions}"
                                      SelectedItem="{Binding SelectedNativeRouteScopeOption, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5">
                            <TextBlock Classes="label" Text="{DynamicResource LocalModeLabel}" />
                            <ComboBox ItemsSource="{Binding NativeConnectionModes}" HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding SelectedNativeConnectionMode, Mode=TwoWay}">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Converter={StaticResource Localize}, ConverterParameter=Mode}" />
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" Content="{DynamicResource BypassChinaMainland}"
                                        IsChecked="{Binding NativeBypassChinaMainland, Mode=TwoWay}"
                                        IsEnabled="{Binding IsNativeBypassChinaEnabled}"
                                        IsVisible="{Binding IsNativeRouteGlobal}"
                                        VerticalAlignment="Bottom" />
                        </Grid>
                        <ToggleSwitch Content="{DynamicResource UnrestrictedRoute}"
                                      IsChecked="{Binding NativeUnrestrictedRoute, Mode=TwoWay}"
                                      IsEnabled="{Binding IsNativeUnrestrictedRouteEnabled}"
                                      IsVisible="{Binding IsNativeUnrestrictedRouteVisible}" />
                        <Button Classes="primary" Command="{Binding StartNativeConnectionCommand}"
                                IsVisible="{Binding !IsLocalConnectionActive}" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <lucide:LucideIcon Kind="Globe" Size="16" />
                            <TextBlock Text="{DynamicResource StartNativeOutbound}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Border>
                  </Expander>
                </Border>
                </Panel>

                <!-- 线路配对: which saved node each forward carries. -->
                <Border Grid.Row="3" Classes="card" IsVisible="{Binding IsPairingVisible}">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <lucide:LucideIcon Kind="GitBranch" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
                      <TextBlock Text="{DynamicResource PairingTitle}" Classes="title" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ConnectionRoutes}" IsVisible="{Binding IsPairingVisible}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ForwardRowViewModel">
                          <Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                            <Grid ColumnDefinitions="*,260" ColumnSpacing="14">
                              <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PortText}" Classes="muted mono" FontSize="11" />
                              </StackPanel>
                              <ComboBox Grid.Column="1" ItemsSource="{Binding NodeOptions}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                        PlaceholderText="{DynamicResource NoSavedNodeSelected}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- 线路配对: standard node editor. -->
                <Border Grid.Row="4" Classes="surface" IsVisible="{Binding IsPairingVisible}">
                  <Expander IsExpanded="{Binding IsProxyEditorExpanded, Mode=TwoWay}"
                            AutomationProperties.Name="{DynamicResource StandardConnectionName}">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="4,10">
                        <lucide:LucideIcon Kind="Server" Size="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource StandardConnection}" Classes="title" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Classes="status-pill" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource AddNode}" FontSize="11" />
                        </Border>
                      </Grid>
                    </Expander.Header>
                    <Border Padding="4,0,4,8">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBox Text="{Binding ProxyImportUri, Mode=TwoWay}" Watermark="ss://, wg:// URI" />
                          <Button Grid.Column="1" Classes="tonal" Command="{Binding ImportProxyUriCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <lucide:LucideIcon Kind="Download" Size="16" />
                              <TextBlock Text="{DynamicResource ImportAndSave}" />
                            </StackPanel>
                          </Button>
                        </Grid>
                        <TextBlock Text="{Binding ProxyImportError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
                          <TextBlock Text="{DynamicResource NodeDetails}" Classes="title" VerticalAlignment="Bottom" />
                          <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="label" Text="{DynamicResource ProtocolLabel}" />
                            <ComboBox ItemsSource="{Binding NodeEditor.ProtocolOptions}" HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding NodeEditor.Protocol, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Converter={StaticResource Localize}, ConverterParameter=ProtocolOption}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5">
                            <TextBlock Classes="label" Text="{DynamicResource NameLabel}" />
                            <TextBox Text="{Binding NodeEditor.Name, Mode=TwoWay}" Watermark="{DynamicResource NameWatermark}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="label" Text="{DynamicResource ServerLabel}" />
                            <TextBox Text="{Binding NodeEditor.Server, Mode=TwoWay}" Watermark="node.example.com" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
                          <StackPanel Spacing="5">
                            <TextBlock Classes="label" Text="{DynamicResource PortLabel}" />
                            <TextBox Text="{Binding NodeEditor.PortText, Mode=TwoWay}" Watermark="443" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding NodeEditor.IsShadowsocks}">
                            <TextBlock Classes="label" Text="{DynamicResource MethodLabel}" />
                            <ComboBox ItemsSource="{Binding NodeEditor.ShadowsocksMethodOptions}" HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding NodeEditor.Method, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                        <StackPanel IsVisible="{Binding NodeEditor.IsShadowsocks}" Spacing="5">
                          <TextBlock Classes="label" Text="{DynamicResource PasswordLabel}" />
                          <TextBox Text="{Binding NodeEditor.Password, Mode=TwoWay}" PasswordChar="*" Watermark="{DynamicResource ShadowsocksPasswordWatermark}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding NodeEditor.IsWireGuard}" Spacing="10">
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="5">
                              <TextBlock Classes="label" Text="{DynamicResource PrivateKeyLabel}" />
                              <TextBox Text="{Binding NodeEditor.PrivateKey, Mode=TwoWay}" PasswordChar="*" Watermark="{DynamicResource PrivateKeyWatermark}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                              <TextBlock Classes="label" Text="{DynamicResource PeerPublicKeyLabel}" />
                              <TextBox Text="{Binding NodeEditor.PeerPublicKey, Mode=TwoWay}" Watermark="{DynamicResource PeerPublicKeyWatermark}" />
                            </StackPanel>
                          </Grid>
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="5">
                              <TextBlock Classes="label" Text="{DynamicResource LocalAddressLabel}" />
                              <TextBox Text="{Binding NodeEditor.LocalAddress, Mode=TwoWay}" Watermark="10.8.0.2/32" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                              <TextBlock Classes="label" Text="{DynamicResource AllowedIpsLabel}" />
                              <TextBox Text="{Binding NodeEditor.AllowedIps, Mode=TwoWay}" Watermark="0.0.0.0/0, ::/0" />
                            </StackPanel>
                          </Grid>
                          <Expander Header="{DynamicResource WireGuardTuning}" IsExpanded="False">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                              <StackPanel Spacing="5">
                                <TextBlock Classes="label" Text="MTU" />
                                <TextBox Text="{Binding NodeEditor.MtuText, Mode=TwoWay}" Watermark="1420" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Classes="label" Text="{DynamicResource KeepaliveLabel}" />
                                <TextBox Text="{Binding NodeEditor.KeepaliveText, Mode=TwoWay}" Watermark="25" />
                              </StackPanel>
                            </Grid>
                          </Expander>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="primary" Command="{Binding SaveConnectionProfileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <lucide:LucideIcon Kind="Save" Size="16" />
                              <TextBlock Text="{DynamicResource SaveNode}" />
                            </StackPanel>
                          </Button>
                          <Button Classes="danger" Command="{Binding DeleteConnectionProfileCommand}"
                                  IsVisible="{Binding HasSelectedConnectionProfile}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <lucide:LucideIcon Kind="Trash2" Size="16" />
                              <TextBlock Text="{DynamicResource Delete}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Expander>
                </Border>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- ============ Activity ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLogsVisible}" RowDefinitions="Auto,*" Margin="32,28,32,96">
          <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="2">
            <TextBlock Classes="heading" Text="{DynamicResource LogsLabel}" />
          </StackPanel>
          <Border Grid.Row="1" Classes="card">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Classes="mono" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ============ Settings ============ -->
        <views:SettingsView Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsSettingsVisible}" />

        <!-- ============ Start / stop with running timer (bottom right) ============ -->
        <Button Grid.Row="1" Classes="fab" Classes.running="{Binding IsAnyRunning}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24"
                Command="{Binding ToggleRunningCommand}" IsVisible="{Binding IsShellVisible}"
                ToolTip.Tip="{Binding RunToggleTip}" AutomationProperties.Name="{DynamicResource RunToggleName}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <lucide:LucideIcon Kind="Pause" Size="20" IsVisible="{Binding IsAnyRunning}" />
            <lucide:LucideIcon Kind="Play" Size="20" IsVisible="{Binding !IsAnyRunning}" />
            <TextBlock Text="{Binding RunningTimeText}" Classes="mono" FontWeight="SemiBold" FontSize="16"
                       VerticalAlignment="Center" IsVisible="{Binding IsAnyRunning}" />
            <TextBlock Text="{DynamicResource Start}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                       IsVisible="{Binding !IsAnyRunning}" />
          </StackPanel>
        </Button>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding IsBusy}">
          <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22">
            <StackPanel Spacing="12">
              <ProgressBar Width="200" IsIndeterminate="True" />
              <TextBlock Text="{Binding BusyMessage}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
