<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LeikwanBridge.Mac.ViewModels"
             xmlns:services="using:LeikwanBridge.Mac.Services"
             xmlns:controls="using:LeikwanBridge.Mac.Controls"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="LeikwanBridge.Mac.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel">
  <!-- FlClash-style dashboard: a grid of 16 px rounded cards. -->
  <ScrollViewer>
    <StackPanel Margin="28,22,28,96" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="heading" Text="Dashboard" />
          <TextBlock Classes="muted" Text="{Binding ServiceHeadline}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon tonal" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Refresh connection">
          <lucide:LucideIcon Kind="RefreshCw" Size="17" />
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">

        <!-- Network speed -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="card" Padding="0" MinHeight="208" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="18,16,18,4">
              <lucide:LucideIcon Kind="Gauge" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
              <TextBlock Grid.Column="1" Text="Network speed" Classes="title" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <lucide:LucideIcon Kind="ArrowUp" Size="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding UploadRateText}" FontSize="12" Classes="muted" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <lucide:LucideIcon Kind="ArrowDown" Size="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding DownloadRateText}" FontSize="12" Classes="muted" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <controls:SpeedChart Grid.Row="1" Margin="0,8,0,0"
                                 DownloadSamples="{Binding DownloadHistory}"
                                 UploadSamples="{Binding UploadHistory}"
                                 Stroke="{DynamicResource ChartStrokeBrush}"
                                 Fill="{DynamicResource ChartFillBrush}"
                                 SecondaryStroke="{DynamicResource ChartSecondaryStrokeBrush}" />
          </Grid>
        </Border>

        <!-- Outbound mode -->
        <Border Grid.Row="0" Grid.Column="2" Classes="card" Padding="12,16,12,12">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,4">
              <lucide:LucideIcon Kind="Waypoints" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
              <TextBlock Text="Outbound mode" Classes="title" />
            </StackPanel>
            <Button Classes="option" Classes.selected="{Binding IsProxyModeSelected}"
                    Command="{Binding SelectOutboundModeCommand}" CommandParameter="{x:Static services:MacConnectionMode.Proxy}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <lucide:LucideIcon Kind="Shuffle" Size="16" />
                <TextBlock Text="System proxy" />
              </StackPanel>
            </Button>
            <Button Classes="option" Classes.selected="{Binding IsVpnModeSelected}"
                    Command="{Binding SelectOutboundModeCommand}" CommandParameter="{x:Static services:MacConnectionMode.Vpn}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <lucide:LucideIcon Kind="Shield" Size="16" />
                <TextBlock Text="TUN (VPN)" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding OutboundModeSummary}" Classes="muted" FontSize="11" Margin="6,2,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Current service -->
        <Border Grid.Row="0" Grid.Column="3" Classes="card">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Layers" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
              <TextBlock Text="Current service" Classes="title" />
            </StackPanel>
            <TextBlock Text="{Binding ServiceHeadline}" Classes="metric" FontSize="18" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="8" Height="8" CornerRadius="4" Classes="status-dot" Classes.running="{Binding IsConnected}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionLabel}" FontSize="13" />
            </StackPanel>
            <TextBlock Text="{Binding ServiceForwardSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SignedInUsername}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <!-- Traffic usage -->
        <Border Grid.Row="1" Grid.Column="0" Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="ChartPie" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
              <TextBlock Text="Traffic usage" Classes="title" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <controls:UsageRing Width="64" Height="64"
                                  Upload="{Binding SessionUploadBytes}" Download="{Binding SessionDownloadBytes}"
                                  UploadBrush="{DynamicResource TertiaryBrush}"
                                  DownloadBrush="{DynamicResource PrimaryBrush}"
                                  TrackBrush="{DynamicResource CardHighBrush}" />
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="14" Height="6" CornerRadius="3" Background="{DynamicResource TertiaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Upload" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="14" Height="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Download" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="2">
              <lucide:LucideIcon Kind="ArrowUp" Size="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding SessionUploadText}" FontSize="13" FontWeight="SemiBold" />
              <lucide:LucideIcon Grid.Row="1" Kind="ArrowDown" Size="13" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SessionDownloadText}" FontSize="13" FontWeight="SemiBold" />
            </Grid>
            <TextBlock Text="Since this window opened" Classes="muted" FontSize="11" />
          </StackPanel>
        </Border>

        <!-- Connections: the local proxy / TUN connection -->
        <Border Grid.Row="1" Grid.Column="1" Classes="card">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <lucide:LucideIcon Kind="Cable" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
              <TextBlock Text="Connections" Classes="title" />
            </StackPanel>
            <Border Classes="status-pill" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="8" Height="8" CornerRadius="4" Classes="status-dot" Classes.running="{Binding IsLocalConnectionActive}" />
                <TextBlock Text="{Binding LocalConnectionStatus}" FontSize="12" />
              </StackPanel>
            </Border>
            <StackPanel Spacing="0">
              <TextBlock Text="Route" Classes="label" />
              <TextBlock Text="{Binding LocalRouteSummary}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Spacing="0">
              <TextBlock Text="Node" Classes="label" />
              <TextBlock Text="{Binding LocalNodeSummary}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Classes="secondary" Command="{Binding ShowConnectionsCommand}" HorizontalAlignment="Left" MinHeight="32" Padding="12,4">
              <TextBlock Text="Open services" FontSize="12" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Forwards overview (read-only; start / stop lives on Services) -->
        <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <lucide:LucideIcon Kind="Network" Size="18" Foreground="{DynamicResource PrimaryBrush}" />
              <TextBlock Grid.Column="1" Text="Forwards" Classes="title" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding ServiceForwardSummary}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="No supported forwards are assigned." Classes="muted" IsVisible="{Binding !HasForwards}" />
            <ItemsControl ItemsSource="{Binding Forwards}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ForwardRowViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                    <Border Width="8" Height="8" CornerRadius="4" Classes="status-dot" Classes.running="{Binding IsRunning}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding PortText}" Classes="mono muted" FontSize="11" VerticalAlignment="Center" />
                    <Border Grid.Column="3" Classes="chip">
                      <TextBlock Text="{Binding Mode}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
