<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <!-- Native apphost/runtime select the architecture; keep managed IL portable
         so cross-architecture packaging can execute a real managed-load probe. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.0.48</Version>
  </PropertyGroup>

  <Target Name="CreateMacBundleAppHost" AfterTargets="_CreateAppHost"
          Condition="$(RuntimeIdentifier.StartsWith('osx-')) and Exists('$(AppHostSourcePath)')">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(AppHostIntermediatePath)"
                   AppBinaryName="../Resources/dotnet/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   EnableMacOSCodeSign="false" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Lucide.Avalonia" Version="0.1.64" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeikwanBridge.Core\LeikwanBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Resources\RuleSets\*.srs" LogicalName="LeikwanBridge.Mac.RuleSets.%(Filename)%(Extension)" />
    <Content Include="Resources\RuleSets\NOTICE.txt" Link="SAGERNET-RULESETS-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\RuleSets\LICENSE.txt" Link="SAGERNET-RULESETS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\RuleSets\COPYING.txt" Link="COPYING.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
