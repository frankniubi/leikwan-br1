<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F5" />
    <SolidColorBrush x:Key="RailBrush" Color="#183B37" />
    <SolidColorBrush x:Key="RailMutedBrush" Color="#B9CBC7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D9E0DE" />
    <SolidColorBrush x:Key="TextBrush" Color="#18211F" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64706D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#087F72" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#06695F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A16207" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF8E8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFF1F0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#147D64" />
    <SolidColorBrush x:Key="QuietBrush" Color="#E9EEEC" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="#F3C7C3" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RailMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="#28514B" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.status-pill">
    <Setter Property="Background" Value="{DynamicResource QuietBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.status-dot">
    <Setter Property="Background" Value="#AAB4B1" />
  </Style>
  <Style Selector="Border.status-dot.running">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
</Styles>
