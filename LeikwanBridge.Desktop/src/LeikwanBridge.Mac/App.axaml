<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LeikwanBridge.Mac.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LeikwanBridge.Mac/Resources/Strings.axaml" />
        <ResourceInclude Source="avares://LeikwanBridge.Mac/Resources/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <!-- Material You accent from the LeiKwan teal seed, per appearance. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#006A62" RegionColor="#F4FBF8" />
        <ColorPaletteResources x:Key="Dark" Accent="#82D5C9" RegionColor="#0E1513" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://LeikwanBridge.Mac/Resources/Theme.axaml" />
  </Application.Styles>
</Application>
