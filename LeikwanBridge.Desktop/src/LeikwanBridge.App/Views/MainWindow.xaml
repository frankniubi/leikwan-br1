<Window x:Class="LeikwanBridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeikwanBridge.App.ViewModels"
        xmlns:conv="clr-namespace:LeikwanBridge.App.Converters"
        xmlns:views="clr-namespace:LeikwanBridge.App.Views"
        Title="{DynamicResource AppTitle}" Height="820" Width="1240"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="/LeikwanBridge.App;component/Resources/Icons/leikwan-host.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToStatusBrushConverter x:Key="StatusBrush"/>
        <conv:BoolToStatusTextConverter x:Key="StatusText"/>
        <conv:ModeToColorConverter x:Key="ModeColor"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:ProfileUploadableToVisibilityConverter x:Key="UploadableToVis"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
        <conv:ResourceTextConverter x:Key="ResourceText"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ProxyIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Cloud badge shown on hosted ("上云") nodes. -->
        <Style x:Key="CloudBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Setup Wizard Overlay -->
        <Grid x:Name="SetupOverlay" Visibility="{Binding ShowSetupWizard, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100" Background="{DynamicResource BgBrush}">
            <Border Style="{StaticResource CardBorder}" MaxWidth="460" MaxHeight="680" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="{DynamicResource SetupTitle}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SetupSubtitle}" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,20"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupEndpoint}"/>
                    <ComboBox x:Name="SetupEndpointCombo" SelectedIndex="0" Margin="0,0,0,4"
                              SelectionChanged="OnEndpointSelectionChanged"
                              AutomationProperties.Name="Connection site">
                        <ComboBoxItem Content="{DynamicResource SetupEndpointCloudflare}" Tag="cloudflare"/>
                        <ComboBoxItem Content="{DynamicResource SetupEndpointAliyun}" Tag="aliyun"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource SetupEndpointHint}" Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Ethernet binding: applied before any sign-in request; same
                         PreferredEgressInterface field as the settings page. -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupEgressInterface}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SetupEgressInterface" Grid.Column="0"
                                  DisplayMemberPath="CompactLabel" SelectedValuePath="Id"
                                  SelectionChanged="OnSetupEgressInterfaceChanged"
                                  AutomationProperties.Name="Ethernet binding"/>
                        <Button x:Name="SetupEgressRefreshButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Width="34" Padding="0"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE72C;"
                                ToolTip="{DynamicResource SetupEgressRefresh}"
                                AutomationProperties.Name="Refresh adapter list"
                                Click="OnSetupEgressRefresh_Click"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource SetupEgressHint}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SetupEgressNotice" Foreground="{DynamicResource WarningBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,-8,0,12" Visibility="Collapsed"/>
                    <!-- Kept off-screen for legacy config normalization/source compatibility. -->
                    <TextBox x:Name="TxtMasterUrl" Visibility="Collapsed"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupClientId}"/>
                    <TextBox Style="{StaticResource InputTextBox}" x:Name="TxtClientId" Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupAgentToken}"/>
                    <PasswordBox x:Name="TxtAgentToken" Padding="10,8" FontSize="13" Margin="0,0,0,20"/>

                    <CheckBox x:Name="SetupSaveInfoCheckBox" Content="{DynamicResource SetupSaveInfo}"
                              IsChecked="True" Margin="0,0,0,12"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionConnect}"
                            Click="OnConnect_Click" HorizontalAlignment="Stretch"/>

                    <TextBlock x:Name="SetupStatus" Margin="0,12,0,0" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="UpdatePromptOverlay"
              Visibility="{Binding IsUpdateOverlayVisible, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="102"
              Background="{DynamicResource ScrimBrush}">
            <Border Style="{StaticResource CardBorder}" MaxWidth="520" MaxHeight="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="8">
                    <TextBlock Text="{DynamicResource UpdateAvailableTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"
                               Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock x:Name="UpdateVersionText"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16"
                               Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>

                    <!-- Update progress: phase + percent + message -->
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding IsUpdateInProgress, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding UpdatePhaseText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdatePercent}" Height="8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding UpdateProgressMessage}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Failure details + retry -->
                    <TextBlock Text="{DynamicResource UpdateFailedTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4"
                               Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding UpdateErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionRetryUpdate}"
                            Command="{Binding RetryUpdateCommand}" Margin="0,0,0,8"
                            Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionDismiss}"
                            Command="{Binding DismissUpdateErrorCommand}"
                            Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionInstallNow}"
                            Click="OnInstallUpdateNow_Click" Margin="0,0,0,8"
                            Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionDeferUpdate}"
                            Click="OnDeferUpdateUntilRestart_Click"
                            Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Layout -->
        <Grid Visibility="{Binding ShowSetupWizard, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (FlClash-style navigation rail) -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
                <DockPanel Margin="12,0">
                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,22,8,18">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/LeikwanBridge.App;component/Resources/Icons/leikwan-host-app.png" Width="30" Height="30"
                                   Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{DynamicResource AppTitle}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SignedInEmail}" FontSize="11" Margin="0,10,0,0"
                                   Foreground="{DynamicResource SidebarTextBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSignedInEmail, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Bottom: status, version, update, sign out -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                        <Border Style="{StaticResource InsetBorder}" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{Binding IsConnected, Converter={StaticResource StatusBrush}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeviceLimitReached}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               MaxWidth="170" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="SidebarVersionButton" Style="{StaticResource NavButton}" Click="OnCheckForUpdates_Click"
                                views:NavIcon.Glyph="&#xE895;" ToolTip="{DynamicResource ActionCheckUpdates}"
                                AutomationProperties.Name="Check for updates">
                            <StackPanel>
                                <TextBlock Text="{Binding AppVersionText}" FontSize="13"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Text="{DynamicResource ActionCheckUpdates}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource ActionSignOut}"
                                views:NavIcon.Glyph="&#xF3B1;" Click="OnSignOut_Click"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavDashboard}" Tag="Dashboard"
                                views:NavIcon.Glyph="&#xF246;"
                                Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavForwards}" Tag="Forwards"
                                views:NavIcon.Glyph="&#xE71B;"
                                Command="{Binding NavigateToCommand}" CommandParameter="Forwards"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavNodes}" Tag="Nodes"
                                views:NavIcon.Glyph="&#xE774;"
                                Command="{Binding NavigateToCommand}" CommandParameter="Nodes"
                                AutomationProperties.Name="My nodes"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavProxy}" Tag="Proxy"
                                views:NavIcon.Glyph="&#xE968;"
                                Command="{Binding NavigateToCommand}" CommandParameter="Proxy"
                                AutomationProperties.Name="Local proxy"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavLog}" Tag="Log"
                                views:NavIcon.Glyph="&#xE9F9;"
                                Command="{Binding NavigateToCommand}" CommandParameter="Log"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavSettings}" Tag="Settings"
                                views:NavIcon.Glyph="&#xE713;"
                                Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1">
                <DockPanel Margin="28,18,28,0">
                    <!-- Page header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Text="{DynamicResource NavDashboard}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SidebarStartAllButton" Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStartAll}"
                                    Visibility="Visible" Margin="0,0,8,0" Command="{Binding StartAllCommand}"/>
                            <Button x:Name="SidebarStopAllButton" Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStopAll}"
                                    Visibility="Visible" Command="{Binding StopAllForwardsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Device limit banner: stays on every view until a config pull is admitted again. -->
                    <Border x:Name="DeviceLimitBanner" DockPanel.Dock="Top" Margin="0,0,0,12" Padding="16,12"
                            CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}"
                            Background="{DynamicResource WarningContainerBrush}"
                            Visibility="{Binding IsDeviceLimitReached, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Device limit reached">
                        <TextBlock Text="{Binding DeviceLimitMessage}" TextWrapping="Wrap" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                    </Border>

                    <Grid>
                        <!-- Dashboard: FlClash-style grid of 16 px cards. -->
                        <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="-6,0,-6,96">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Network speed -->
                                    <Border x:Name="DashSpeedCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DashCard}"
                                            Height="236" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <DockPanel Margin="22,20,22,8">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ChartUpBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SpeedOutText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ChartDownBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SpeedInText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xEC4A;"/>
                                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource DashNetworkSpeed}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Grid.Row="1" CornerRadius="0,0,16,16" ClipToBounds="True">
                                                <views:SpeedChart x:Name="DashSpeedChart" Margin="0,4,0,0"
                                                                  PrimaryBrush="{DynamicResource ChartDownBrush}"
                                                                  SecondaryBrush="{DynamicResource ChartUpBrush}"
                                                                  GridBrush="{DynamicResource BorderBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Outbound mode -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashCard}" Height="236">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE8AB;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource DashOutboundMode}"/>
                                            </StackPanel>
                                            <RadioButton x:Name="DashModeHttp" GroupName="DashMode" Style="{StaticResource SegmentButton}" Tag="Http"
                                                         Checked="OnDashModeChecked" AutomationProperties.Name="System proxy mode">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ProxyModeHttp}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="DashModeTun" GroupName="DashMode" Style="{StaticResource SegmentButton}" Tag="Tun"
                                                         Checked="OnDashModeChecked" AutomationProperties.Name="TUN mode">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ProxyModeTun}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="DashModeProcess" GroupName="DashMode" Style="{StaticResource SegmentButton}" Tag="Process"
                                                         Checked="OnDashModeChecked" AutomationProperties.Name="Process mode">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ProxyModeProcess}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>

                                    <!-- Current service -->
                                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource DashCard}" Height="236">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE71B;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource DashCurrentService}"/>
                                            </StackPanel>
                                            <Grid>
                                                <StackPanel Visibility="{Binding PairedProxyForwardRows.Count, Converter={StaticResource ZeroToVis}, ConverterParameter=invert}">
                                                    <ComboBox x:Name="DashServiceCombo" ItemsSource="{Binding PairedProxyForwardRows}"
                                                              SelectedValuePath="ForwardId" SelectedValue="{Binding SelectedProxyForwardId, Mode=TwoWay}"
                                                              SelectionChanged="OnDashServiceSelectionChanged"
                                                              AutomationProperties.Name="Current service">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRowNode}" Margin="0,12,0,2"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SelectedProxyPairedForwardNode}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                        <Border Style="{StaticResource CloudBadge}" Margin="6,0,0,0"
                                                                Visibility="{Binding SelectedPairedProxyForward.IsCloudNode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                       Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRouteListenPort}" Margin="0,10,0,2"/>
                                                    <TextBlock Text="{Binding SelectedProxyPairedForwardEndpoint}" FontFamily="Consolas" FontSize="13"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding PairedProxyForwardRows.Count, Converter={StaticResource ZeroToVis}}">
                                                    <TextBlock Text="{DynamicResource DashPairHint}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                                    <Button Style="{StaticResource TonalButton}" Content="{DynamicResource DashOpenServices}"
                                                            HorizontalAlignment="Left" Click="OnDashOpenServices_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </DockPanel>
                                    </Border>

                                    <!-- Traffic usage -->
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xEB05;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource DashTrafficUsage}"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <views:RingGauge Width="62" Height="62" Value="{Binding TrafficInShare}" Margin="0,0,14,0"
                                                                 FillBrush="{DynamicResource ChartDownBrush}" TrackBrush="{DynamicResource ChartUpBrush}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource ChartDownBrush}"/>
                                                        <TextBlock Text="{Binding TotalBytesIn}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource ChartUpBrush}"/>
                                                        <TextBlock Text="{Binding TotalBytesOut}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Connections -->
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE8CE;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource DashConnections}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ActiveForwardCount}" Style="{StaticResource BigValue}"/>
                                                <TextBlock Text="{Binding ForwardCount, StringFormat={} / {0}}" FontSize="16" VerticalAlignment="Bottom"
                                                           Margin="2,0,0,4" Foreground="{DynamicResource MutedTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource DashActiveForwards}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                            <TextBlock Style="{StaticResource MutedText}"><Run Text="{DynamicResource DashLastSync}"/><Run Text=" "/><Run Text="{Binding LastSyncTime, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Version / update -->
                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE946;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource DashVersion}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashVersionText" Text="{Binding AppVersionText}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UpdateCheckStatus}" Style="{StaticResource MutedText}" Margin="0,2,0,8"/>
                                            <Button Style="{StaticResource TonalButton}" Content="{DynamicResource ActionCheckUpdates}"
                                                    HorizontalAlignment="Left" Click="OnCheckForUpdates_Click" Padding="14,7"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cloud nodes -->
                                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource DashCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE753;"/>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource DashCloudNodes}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding HostedNodeCount}" Style="{StaticResource BigValue}"/>
                                                <TextBlock Text="{Binding LocalNodeCount, StringFormat={} + {0}}" FontSize="16" VerticalAlignment="Bottom"
                                                           Margin="2,0,0,4" Foreground="{DynamicResource MutedTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CloudStatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashForwardControls}" DockPanel.Dock="Left" Margin="0"/>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}">
                                                       <Run Text="{Binding ForwardCount, Mode=OneWay}"/>
                                                       <Run Text="{DynamicResource DashForwardsShownSuffix}"/>
                                                   </TextBlock>
                                        </DockPanel>
                                        <Border x:Name="DashboardForwardLoading" Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12"
                                                Visibility="{Binding IsLoadingForwards, Converter={StaticResource BoolToVis}}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <ProgressBar Width="220" Height="6" IsIndeterminate="True"/>
                                                <TextBlock Text="{DynamicResource DashForwardLoading}" Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{DynamicResource DashNoVisibleForwards}" Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,0,0,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ForwardCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Forwards}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadingForwards}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InsetBorder}" Width="300" Margin="0,0,10,10" Cursor="Hand"
                                                            MouseLeftButtonUp="OnForwardCardClick">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,10">
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                    <Ellipse Style="{StaticResource StatusDot}"
                                                                             Fill="{Binding Summary.CanStop, Converter={StaticResource StatusBrush}}"/>
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="15" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               TextWrapping="Wrap" MaxWidth="205"/>
                                                                </StackPanel>
                                                                <Border DockPanel.Dock="Right" Style="{StaticResource ModeBadge}"
                                                                        Background="{DynamicResource SecondaryContainerBrush}"
                                                                        HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding Summary.QualityText, Converter={StaticResource ResourceText}, ConverterParameter=Quality}" FontSize="11"
                                                                               Foreground="{DynamicResource OnSecondaryContainerBrush}" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </DockPanel>

                                                            <!-- Native outbound rules ship configuration only: no start/stop control. -->
                                                            <TextBlock Text="{DynamicResource ForwardNativeOutboundRule}" FontSize="11"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                                                       Visibility="{Binding Summary.IsNativeOutboundRule, Converter={StaticResource BoolToVis}}"/>

                                                            <TextBlock Text="{Binding Summary.Lifecycle, Converter={StaticResource ResourceText}, ConverterParameter=State}" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                                       Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding Summary.FriendlyMessage, Converter={StaticResource ResourceText}, ConverterParameter=State}" FontSize="12"
                                                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                                                       Margin="0,0,0,8"/>

                                                            <WrapPanel HorizontalAlignment="Right">
                                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStop}" Margin="0,0,6,6"
                                                                        Command="{Binding DataContext.StopForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding Summary.CanStop, Converter={StaticResource BoolToVis}}"/>
                                                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStart}" Margin="0,0,0,6"
                                                                        Command="{Binding DataContext.StartForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding Summary.CanStart, Converter={StaticResource BoolToVis}}"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                                                Visibility="{Binding SelectedForward, Converter={StaticResource NullToVis}}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource ForwardDetailsTitle}" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource ForwardDetailsForward}"/>
                                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                                        <TextBlock Text="{Binding SelectedForward.DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <!-- Native outbound rules ship configuration only: no start/stop control. -->
                                                        <TextBlock Text="{DynamicResource ForwardNativeOutboundRule}" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding SelectedForward.Summary.IsNativeOutboundRule, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource ForwardDetailsStatus}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedForward.Summary.Lifecycle, Converter={StaticResource ResourceText}, ConverterParameter=State}" FontSize="14"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource ForwardDetailsQuality}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedForward.Summary.QualityText, Converter={StaticResource ResourceText}, ConverterParameter=Quality}" FontSize="14"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource ForwardDetailsMessage}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedForward.Summary.FriendlyMessage, Converter={StaticResource ResourceText}, ConverterParameter=State}" FontSize="14" TextWrapping="Wrap"/>
                                                </Grid>

                                                <WrapPanel HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStop}" Margin="0,0,6,6"
                                                            Command="{Binding StopForwardCommand}"
                                                            CommandParameter="{Binding SelectedForward}"
                                                            Visibility="{Binding SelectedForward.Summary.CanStop, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStart}" Margin="0,0,0,6"
                                                            Command="{Binding StartForwardCommand}"
                                                            CommandParameter="{Binding SelectedForward}"
                                                            Visibility="{Binding SelectedForward.Summary.CanStart, Converter={StaticResource BoolToVis}}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>


                        <!-- Services: forward pairing (configuration only, never starts a runtime connection). -->
                        <ScrollViewer x:Name="ForwardPairingPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="-6,0,-6,96">
                                <TextBlock Text="{DynamicResource ForwardPairingHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="6,0,6,10"/>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <ItemsControl x:Name="ForwardPairingRows" ItemsSource="{Binding ProxyForwardRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InsetBorder}" Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="260"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{DynamicResource ProxyRouteListenPort}" FontSize="11"
                                                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
                                                                <TextBlock Text="{Binding ListenerEndpoint}" FontFamily="Consolas" FontSize="12"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRowNode}"/>
                                                                <ComboBox ItemsSource="{Binding Profiles}" SelectedValuePath="Id"
                                                                          SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}"
                                                                          SelectionChanged="OnProxyRowProfileSelectionChanged"
                                                                          AutomationProperties.Name="{Binding Title}">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0"
                                                                                           VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"
                                                                                           Visibility="{Binding IsHosted, Converter={StaticResource BoolToVis}}"/>
                                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ForwardPairingStatus" FontSize="12" Foreground="{DynamicResource SuccessBrush}"
                                                   Margin="0,2,0,10"/>
                                        <WrapPanel HorizontalAlignment="Right">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ForwardPairingSave}"
                                                    Click="OnSaveForwardPairings_Click" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource DashOpenNodes}"
                                                    Click="OnOpenNodes_Click" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ForwardPairingOpenProxy}"
                                                    Command="{Binding NavigateToCommand}" CommandParameter="Proxy"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>


                        <!-- Nodes: the user's own nodes, cloud sync ("上云") and pairing per service. -->
                        <ScrollViewer x:Name="NodesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="-6,0,-6,96">
                                <!-- Cloud sync -->
                                <Border x:Name="NodesCloudCard" Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource SecondaryContainerBrush}" ToolTip="{DynamicResource NodesCloudHint}"
                                                VerticalAlignment="Top" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                       Foreground="{DynamicResource OnSecondaryContainerBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource NodesCloudTitle}" FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ProgressBar Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0" Background="Transparent"
                                                             Visibility="{Binding IsCloudBusy, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock x:Name="NodesCloudStatus" Text="{Binding CloudStatusText}" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCloudError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button x:Name="NodesRefreshCloudButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                                    Click="OnNodesRefreshCloud_Click" IsEnabled="{Binding IsCloudBusy, Converter={StaticResource InverseBool}}"
                                                    AutomationProperties.Name="Refresh from cloud">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource NodesRefreshCloud}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="NodesSyncAllButton" Style="{StaticResource PrimaryButton}"
                                                    Click="OnNodesSyncAll_Click" IsEnabled="{Binding IsCloudBusy, Converter={StaticResource InverseBool}}"
                                                    AutomationProperties.Name="Sync all nodes to cloud">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource NodesSyncAll}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Import -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE8C8;"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource NodesImportTitle}"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,10,0">
                                                <TextBox x:Name="NodesImportText" Style="{StaticResource InputTextBox}" AcceptsReturn="True"
                                                         TextWrapping="NoWrap" MinHeight="40" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas" AutomationProperties.Name="Share links to import"
                                                         ToolTip="{DynamicResource NodesImportHint}"/>
                                                <TextBlock Text="ss:// · socks5:// · vless://" Margin="11,0,11,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="13" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=NodesImportText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource NodesPaste}" Margin="0,0,8,0"
                                                        Click="OnNodesPaste_Click" Height="40"/>
                                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource NodesImport}"
                                                        Click="OnNodesImport_Click" Height="40" AutomationProperties.Name="Import nodes"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="NodesStatusText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Saved nodes (list + editor). Hosted nodes carry a cloud badge. -->
                                <Border x:Name="ForwardPairingNodeSection" Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="340"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,14,0">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE774;"/>
                                                        <TextBlock Text="{DynamicResource ProxyMyNodes}" Style="{StaticResource CardTitle}"/>
                                                        <TextBlock Text="{Binding ProxyProfiles.Count, StringFormat={}  {0}}" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource ProxyIconButton}" Content="&#xE710;"
                                                            ToolTip="{DynamicResource ProxyNew}"
                                                            Click="OnPairingNew_Click" AutomationProperties.Name="New proxy profile"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{DynamicResource NodesEmpty}" Style="{StaticResource MutedText}" Margin="4,8"
                                                           Visibility="{Binding ProxyProfiles.Count, Converter={StaticResource ZeroToVis}}"/>
                                                <ListBox x:Name="ForwardPairingProfileList" Grid.Row="1" ItemsSource="{Binding ProxyProfiles}"
                                                         SelectedValuePath="Id" SelectionChanged="OnPairingProfileSelectionChanged"
                                                         MaxHeight="440" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                                         AutomationProperties.Name="Saved nodes">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="4,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                                   FontWeight="SemiBold" MaxWidth="170"/>
                                                                        <Border Style="{StaticResource CloudBadge}" Margin="8,0,0,0"
                                                                                ToolTip="{DynamicResource NodesCloudBadgeTip}"
                                                                                Visibility="{Binding IsHosted, Converter={StaticResource BoolToVis}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,4,0"
                                                                                           VerticalAlignment="Center" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                                                <TextBlock Text="{DynamicResource NodesCloudBadge}" FontSize="11"
                                                                                           Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding DisplayProtocol}" FontSize="10" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Server}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource IconButton}" Content="&#xE898;" Width="30" Height="30"
                                                                            ToolTip="{DynamicResource NodesUpload}" Click="OnNodeUpload_Click"
                                                                            Visibility="{Binding Converter={StaticResource UploadableToVis}}"
                                                                            AutomationProperties.Name="Upload node to cloud"/>
                                                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Width="30" Height="30"
                                                                            ToolTip="{DynamicResource NodesCopyLink}" Click="OnNodeCopyLink_Click"
                                                                            AutomationProperties.Name="Copy share link"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Style="{StaticResource ProxyIconButton}" Content="&#xE70F;" Click="OnPairingEdit_Click"
                                                            ToolTip="{DynamicResource ProxyEdit}" AutomationProperties.Name="Edit saved node" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource ProxyIconButton}" Content="&#xE74D;" Click="OnPairingDelete_Click"
                                                            ToolTip="{DynamicResource ProxyDelete}" AutomationProperties.Name="Delete saved node"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Expander x:Name="ForwardPairingNodeEditorExpander" Grid.Column="1" IsExpanded="True"
                                                  Header="{DynamicResource ProxyManualTitle}" Margin="16,-8,0,0"
                                                  AutomationProperties.Name="Pairing node editor">
                                            <StackPanel Margin="0,4,0,0">
                                                <Border Background="{DynamicResource SecondaryContainerBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,10"
                                                        Visibility="{Binding ProxyEditor.IsHosted, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                        <TextBlock Text="{DynamicResource NodesEditingHosted}" TextWrapping="Wrap" FontSize="12"
                                                                   Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyImportPrompt}"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Grid Margin="0,0,8,0">
                                                        <TextBox x:Name="PairingImportUri" Style="{StaticResource InputTextBox}"
                                                                 AutomationProperties.Name="{DynamicResource ProxyImportPrompt}"
                                                                 AutomationProperties.HelpText="{DynamicResource ProxyImportSupported}"/>
                                                        <TextBlock x:Name="PairingImportPlaceholder" Text="ss://" Margin="11,0,11,0"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="13" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=PairingImportUri}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource ProxyImport}"
                                                            Click="OnPairingImport_Click" AutomationProperties.Name="Import proxy URI"/>
                                                </Grid>
                                                <TextBlock Text="{DynamicResource ProxyImportSupported}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyProtocol}"/>
                                                        <ComboBox ItemsSource="{Binding ProxyEditor.ProtocolOptions}" SelectedItem="{Binding ProxyEditor.Protocol, Mode=TwoWay}"
                                                                  AutomationProperties.Name="Proxy protocol"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyName}"/>
                                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServer}"/>
                                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Server, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPort}"/>
                                                        <ComboBox ItemsSource="{Binding ProxyEditor.PortOptions}" IsEditable="True"
                                                                  Text="{Binding ProxyEditor.PortText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding ProxyEditor.IsSocks5}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxySocksUsername}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                                             AutomationProperties.Name="SOCKS5 username"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding ProxyEditor.IsVless}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPassword}"/>
                                                    <PasswordBox x:Name="PairingProxyPassword" Padding="10,8" FontSize="13" Margin="0,0,0,8"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding ProxyEditor.IsShadowsocks}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyMethod}"/>
                                                    <ComboBox ItemsSource="{Binding ProxyEditor.ShadowsocksMethodOptions}" SelectedItem="{Binding ProxyEditor.Method, Mode=TwoWay}" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPlugin}"/>
                                                            <ComboBox ItemsSource="{Binding ProxyEditor.ShadowsocksPluginOptions}" SelectedItem="{Binding ProxyEditor.Plugin, Mode=TwoWay}"
                                                                      AutomationProperties.Name="Shadowsocks plugin"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPluginOpts}"/>
                                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.PluginOpts, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <CheckBox Content="{DynamicResource ProxyUdpOverTcp}" IsChecked="{Binding ProxyEditor.UdpOverTcp, Mode=TwoWay}" Margin="0,0,0,8"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding ProxyEditor.IsVless}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyUuid}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Uuid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyTransport}"/><ComboBox ItemsSource="{Binding ProxyEditor.VlessTransportOptions}" SelectedItem="{Binding ProxyEditor.Transport, Mode=TwoWay}"/></StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyFlow}"/><TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Flow, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyHost}"/><TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Host, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPath}"/><TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Path, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServiceName}" Visibility="{Binding ProxyEditor.IsVlessGrpc, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.ServiceName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ProxyEditor.IsVlessGrpc, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServerName}"/><TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.ServerName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyFingerprint}"/><TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Fingerprint, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRealityKey}"/><TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.RealityPublicKey, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,8"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRealityShortId}"/><TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.RealityShortId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal"><CheckBox Content="{DynamicResource ProxyTls}" IsChecked="{Binding ProxyEditor.Tls, Mode=TwoWay}" Margin="0,0,16,0"/><CheckBox Content="{DynamicResource ProxyAllowInsecure}" IsChecked="{Binding ProxyEditor.AllowInsecure, Mode=TwoWay}"/></StackPanel>
                                                </StackPanel>
                                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ProxySave}" Click="OnPairingSave_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                </Border>


                                <!-- Pairing per service -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource CardTitleIcon}" Text="&#xE71B;"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource NodesPairingTitle}"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource DashNoVisibleForwards}" Style="{StaticResource MutedText}"
                                                   Visibility="{Binding ProxyForwardRows.Count, Converter={StaticResource ZeroToVis}}"/>
                                        <ItemsControl x:Name="NodesPairingRows" ItemsSource="{Binding ProxyForwardRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InsetBorder}" Padding="14,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="260"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ListenerEndpoint}" FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Style="{StaticResource CloudBadge}" Margin="0,0,10,0"
                                                                    ToolTip="{DynamicResource NodesCloudPairedTip}"
                                                                    Visibility="{Binding IsCloudNode, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,4,0"
                                                                               VerticalAlignment="Center" Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                                    <TextBlock Text="{DynamicResource NodesCloudBadge}" FontSize="11"
                                                                               Foreground="{DynamicResource OnSecondaryContainerBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedValuePath="Id"
                                                                      SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanSelectProfile}"
                                                                      SelectionChanged="OnProxyRowProfileSelectionChanged"
                                                                      AutomationProperties.Name="{Binding Title}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0"
                                                                                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"
                                                                                       Visibility="{Binding IsHosted, Converter={StaticResource BoolToVis}}"/>
                                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>


                        <!-- Local proxy view -->
                        <Grid x:Name="ProxyPanel" Visibility="Collapsed" SizeChanged="OnProxyPanelSizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                
                                    <Border x:Name="ProxyStatusBanner" Grid.Column="1" Padding="12,6"
                                            CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                        <TextBlock x:Name="ProxyStatusTitle" Text="{DynamicResource ProxyDisconnected}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ProxySidebarColumn" Width="0"/></Grid.ColumnDefinitions>
                                <Border x:Name="ProxySavedNodesSidebar" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,0,0" Padding="16,4,0,0" Margin="18,0,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource ProxyMyNodes}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button x:Name="ProxyNewButton" Grid.Column="1" Style="{StaticResource ProxyIconButton}" Content="&#xE710;"
                                                    ToolTip="{DynamicResource ProxyNew}" Click="OnProxyNew_Click" AutomationProperties.Name="New proxy profile"/>
                                        </Grid>
                                        <ListBox x:Name="ProxyProfileList" Grid.Row="1" ItemsSource="{Binding ProxyProfiles}" SelectedValuePath="Id"
                                                 SelectionChanged="OnProxyProfileSelectionChanged" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                                 AutomationProperties.Name="Saved nodes">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,8">
                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Protocol}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource ProxyIconButton}" Content="&#xE70F;" Click="OnProxyEdit_Click"
                                                    ToolTip="{DynamicResource ProxyEdit}" AutomationProperties.Name="Edit saved node" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource ProxyIconButton}" Content="&#xE74D;" Click="OnProxyDelete_Click"
                                                    ToolTip="{DynamicResource ProxyDelete}" AutomationProperties.Name="Delete saved node"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                  <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource ProxyForward}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxySelectPairedForward}"/>
                                            <ComboBox x:Name="ProxyPairedForwardCombo" ItemsSource="{Binding PairedProxyForwardRows}"
                                                      SelectedValuePath="ForwardId" SelectedValue="{Binding SelectedProxyForwardId, Mode=TwoWay}"
                                                      SelectionChanged="OnProxyPairedForwardSelectionChanged"
                                                      AutomationProperties.Name="{DynamicResource ProxySelectPairedForward}" MinHeight="38">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="2,3">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <WrapPanel Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding ListenerEndpoint}" FontFamily="Consolas" FontSize="11"/>
                                                                <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                                                <TextBlock Text="{Binding SelectedProfileName}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyMode}" Margin="0,12,0,0"/>
                                            <ComboBox x:Name="ProxyModeCombo" SelectedIndex="0" SelectionChanged="OnProxyModeSelectionChanged"
                                                      AutomationProperties.Name="Proxy mode" MinHeight="38">
                                                <ComboBoxItem Content="{DynamicResource ProxyModeSelect}" Tag=""/>
                                                <ComboBoxItem Content="{DynamicResource ProxyModeHttp}" Tag="Http"/>
                                                <ComboBoxItem Content="{DynamicResource ProxyModeTun}" Tag="Tun"/>
                                                <ComboBoxItem Content="{DynamicResource ProxyModeProcess}" Tag="Process"/>
                                            </ComboBox>
                                            <TextBlock Text="{DynamicResource ProxyPairedForwardHint}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
                                                <Button x:Name="ProxySelectedConnectButton" Style="{StaticResource PrimaryButton}"
                                                        Content="{DynamicResource ProxyConnect}" Click="OnProxySelectedConnect_Click"
                                                        IsEnabled="{Binding IsProxyReadyForSelectedPairedForward}" Margin="0,0,8,0"/>
                                                <Button x:Name="ProxySelectedDisconnectButton" Style="{StaticResource DangerButton}"
                                                        Content="{DynamicResource ProxyDisconnect}" Click="OnProxySelectedDisconnect_Click"
                                                        IsEnabled="{Binding IsProxyConnectedForSelectedPairedForward}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="16" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource ProxyRouteListenPort}" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{Binding SelectedProxyPairedForwardEndpoint}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedProxyPairedForwardNode}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <ComboBox x:Name="ProxyForwardCombo" Visibility="Collapsed" ItemsSource="{Binding ProxyForwardOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="ForwardId"
                                                  SelectedValue="{Binding SelectedProxyForwardId, Mode=OneWay}"
                                                  SelectionChanged="OnProxyForwardSelectionChanged"/>
                                    </StackPanel>
                                <TextBlock x:Name="ProxyStatusText" Text="{DynamicResource ProxyReady}" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Text="{DynamicResource ProxyExternalConnectionHint}" FontSize="11"
                                   Visibility="{Binding AllowInboundProxy, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Expander x:Name="ProxyNodeEditorExpander" IsExpanded="False" Header="{DynamicResource ProxyConnectionTitle}"
                                          Margin="0,8,0,16" Visibility="Visible" AutomationProperties.Name="Proxy connection settings">
                                    <StackPanel Margin="0,8,0,0">

                                        <Border x:Name="ProxyManualSection" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource ProxyManualTitle}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyProtocol}"/>
                                        <ComboBox ItemsSource="{Binding ProxyEditor.ProtocolOptions}" SelectedItem="{Binding ProxyEditor.Protocol, Mode=TwoWay}"
                                                  AutomationProperties.Name="Proxy protocol" Margin="0,0,0,8"/>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyName}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Name, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Proxy profile name"/>
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServer}"/>
                                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Server, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Proxy server"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPort}"/>
                                                        <ComboBox ItemsSource="{Binding ProxyEditor.PortOptions}" IsEditable="True"
                                                                  Text="{Binding ProxyEditor.PortText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Proxy port"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="ProxySsFields">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProxyEditor.IsShadowsocks}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyMethod}"/>
                                                    <ComboBox ItemsSource="{Binding ProxyEditor.ShadowsocksMethodOptions}"
                                                              SelectedItem="{Binding ProxyEditor.Method, Mode=TwoWay}"
                                                              Margin="0,0,0,8" AutomationProperties.Name="Shadowsocks cipher"/>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPassword}"/>
                                                    <PasswordBox x:Name="ProxyPassword" Padding="10,8" FontSize="13" Margin="0,0,0,8"
                                                                 AutomationProperties.Name="Proxy password"/>
                                                    <CheckBox Content="{DynamicResource ProxyUdpOverTcp}" IsChecked="{Binding ProxyEditor.UdpOverTcp, Mode=TwoWay}"
                                                              Margin="0,0,0,8"/>
                                                </StackPanel>

                                                <StackPanel x:Name="ProxyVlessFields">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProxyEditor.IsVless}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyUuid}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Uuid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyTransport}"/>
                                                            <ComboBox ItemsSource="{Binding ProxyEditor.VlessTransportOptions}"
                                                                      SelectedItem="{Binding ProxyEditor.Transport, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyFlow}"/>
                                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Flow, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyHost}"/>
                                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Host, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPath}"/>
                                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Path, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServiceName}"
                                                               Visibility="{Binding ProxyEditor.IsVlessGrpc, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.ServiceName, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ProxyEditor.IsVlessGrpc, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServerName}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyFingerprint}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Fingerprint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRealityKey}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.RealityPublicKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRealityShortId}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.RealityShortId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Content="{DynamicResource ProxyTls}" IsChecked="{Binding ProxyEditor.Tls, Mode=TwoWay}" Margin="0,0,16,0"/>
                                                        <CheckBox Content="{DynamicResource ProxyAllowInsecure}" IsChecked="{Binding ProxyEditor.AllowInsecure, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="ProxyConnectionSection" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,12"
                                                IsEnabled="{Binding IsExternalProxySelected, Converter={StaticResource InverseBool}}">
                                            <StackPanel Margin="0,0,0,0">
                                                <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource ProxyConnectionTitle}" Margin="0,0,0,8"/>
                                                <TextBlock Text="{DynamicResource ProxyElevationHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                 <CheckBox x:Name="ProxyBypassChinaCheckBox"
                                                           Content="{DynamicResource ProxyBypassChinaMainland}"
                                                           IsChecked="{Binding Config.ProxyBypassChinaMainland, Mode=TwoWay}"
                                                           Margin="0,0,0,10"
                                                           AutomationProperties.Name="Bypass mainland China IPs"/>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyDnsMode}"/>
                                                        <ComboBox x:Name="ProxyDnsModeCombo"
                                                                  SelectionChanged="OnProxyDnsModeSelectionChanged"
                                                                  AutomationProperties.Name="Proxy DNS mode">
                                                            <ComboBoxItem Content="{DynamicResource ProxyDnsRemote}" Tag="Remote"/>
                                                            <ComboBoxItem Content="{DynamicResource ProxyDnsCustom}" Tag="Custom"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel x:Name="ProxyDnsServersPanel" Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyDnsServers}"/>
                                                        <TextBox x:Name="ProxyDnsServersText"
                                                                 Style="{StaticResource InputTextBox}"
                                                                 TextChanged="OnProxyDnsServersTextChanged"
                                                                 AutomationProperties.Name="Custom DNS servers"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{DynamicResource ProxyDnsHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyLocalListenPort}"/>
                                                        <ComboBox x:Name="ProxyLocalListenPortCombo"
                                                                  ItemsSource="{Binding ProxyEditor.LocalListenPortOptions}"
                                                                  IsEditable="True"
                                                                  AutomationProperties.Name="Local proxy listen port"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{DynamicResource ProxyLocalListenPortHint}"
                                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                                               VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                                                </Grid>


                                        <StackPanel x:Name="ProxyGameCard" Margin="0,0,0,12" Visibility="Collapsed">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyGame}" DockPanel.Dock="Left"/>
                                                    <WrapPanel DockPanel.Dock="Right">
                                                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyAddGame}"
                                                                Click="OnProxyAddGame_Click" Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyImportNetchModes}"
                                                                Click="OnProxyImportNetchModes_Click" Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyRefreshGames}"
                                                                Click="OnProxyRefreshGames_Click"/>
                                                    </WrapPanel>
                                                </DockPanel>
                                                <TextBlock Text="{DynamicResource ProxyGameHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <ComboBox x:Name="ProxyGameCombo" ItemsSource="{Binding ProxyGameOptions}"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding SelectedProxyGameId, Mode=OneWay}"
                                                          SelectionChanged="OnProxyGameSelectionChanged"
                                                          AutomationProperties.Name="Game to proxy">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel LastChildFill="True">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}"
                                                                           HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                 </ComboBox.ItemTemplate>
                                             </ComboBox>
                                                 <Border Background="{DynamicResource InfoContainerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                         CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                                     <DockPanel LastChildFill="True">
                                                         <TextBlock Text="{DynamicResource ProxyActiveGame}" FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0"
                                                                    DockPanel.Dock="Left"/>
                                                         <TextBlock Text="{Binding SelectedProxyGameDisplayName}" FontWeight="Bold"
                                                                    Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                     </DockPanel>
                                                 </Border>
                                         </StackPanel>
                                     </StackPanel>
                                                <Button x:Name="ProxyTestUdpButton" Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyTestUdp}"
                                                        Click="OnProxyTestUdp_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="ProxySaveNodeButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource ProxySave}" Visibility="Collapsed"
                                                Click="OnProxySave_Click" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <Border x:Name="NativeOutboundCard" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12"
                                        Visibility="Collapsed">
                                    <Expander x:Name="NativeOutboundExpander"
                                              IsExpanded="{Binding IsNativeOutboundExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="Optional native outbound">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="True" Margin="2,0,2,4">
                                                <TextBlock Style="{StaticResource SectionHeader}"
                                                           Text="{DynamicResource ProxyNativeOutboundTitle}"
                                                           DockPanel.Dock="Left" Margin="0" />
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceVariantBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="{DynamicResource ProxyNativeOutboundOptional}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DockPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource ProxyNativeOutboundHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyNativeOutboundForward}"/>
                                                    <ComboBox x:Name="NativeForwardCombo"
                                                              ItemsSource="{Binding NativeOutboundForwards}"
                                                              SelectedValuePath="ForwardId"
                                                              SelectedValue="{Binding SelectedNativeForwardId, Mode=TwoWay}"
                                                              SelectionChanged="OnNativeForwardSelectionChanged"
                                                              AutomationProperties.Name="Native outbound forward">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Direction}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11">
                                                                               <Run Text="{DynamicResource ForwardNumberPrefix}"/><Run Text="{Binding ForwardId, Mode=OneWay}"/>
                                                                           </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock x:Name="NativeDirectionText" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel x:Name="NativeRouteScopePanel" Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyNativeOutboundRouteScope}"/>
                                                    <ComboBox x:Name="NativeRouteScopeCombo"
                                                              MinWidth="160"
                                                              SelectionChanged="OnNativeRouteScopeSelectionChanged"
                                                              AutomationProperties.Name="Native outbound route scope"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyNativeOutboundMode}"/>
                                                    <ComboBox x:Name="NativeModeCombo" SelectedIndex="1"
                                                              AutomationProperties.Name="Native outbound mode">
                                                        <ComboBoxItem Content="{DynamicResource ProxyModeHttp}" Tag="Http"/>
                                                        <ComboBoxItem Content="{DynamicResource ProxyModeTun}" Tag="Tun"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <CheckBox x:Name="NativeBypassChinaCheckBox" Grid.Column="1"
                                                          Content="{DynamicResource ProxyBypassChinaMainland}"
                                                          IsChecked="{Binding NativeBypassChinaMainland, Mode=TwoWay}"
                                                          VerticalAlignment="Bottom" Margin="8,0,0,4"
                                                          AutomationProperties.Name="Native outbound bypass mainland China IPs"/>
                                            </Grid>
                                            <CheckBox x:Name="NativeUnrestrictedRouteCheckBox"
                                                      Content="{DynamicResource ProxyNativeOutboundUnrestricted}"
                                                      IsChecked="{Binding NativeUnrestrictedRoute, Mode=TwoWay}"
                                                      Margin="0,0,0,10"
                                                      AutomationProperties.Name="Unrestricted native full route"/>
                                            <WrapPanel HorizontalAlignment="Right">
                                                <Button x:Name="NativeOutboundStopButton" Style="{StaticResource ProxyIconButton}" Content="&#xE71A;"
                                                        Foreground="{DynamicResource DangerBrush}" ToolTip="{DynamicResource ProxyStop}"
                                                        Click="OnProxyStop_Click" Visibility="Collapsed" Margin="0,0,8,0"
                                                        AutomationProperties.Name="Stop native outbound"/>
                                                <Button x:Name="NativeOutboundStartButton" Style="{StaticResource PrimaryButton}"
                                                        Content="{DynamicResource ProxyNativeOutboundStart}"
                                                        Click="OnNativeOutboundStart_Click"
                                                        AutomationProperties.Name="Start native outbound"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                                  </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- Log View -->
                        <DockPanel x:Name="LogPanel" Visibility="Collapsed">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource LogClear}"
                                        Command="{Binding ClearLogCommand}" DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,24">
                                <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="11"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         x:Name="LogListBox">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>

                        <!-- Settings View -->
                        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,96">

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SettingsConnection}" FontSize="15"
                                                   FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupEndpoint}"/>
                                        <ComboBox x:Name="SettEndpointCombo" SelectedIndex="0" Margin="0,0,0,4"
                                                  SelectionChanged="OnEndpointSelectionChanged"
                                                  AutomationProperties.Name="Connection site">
                                            <ComboBoxItem Content="{DynamicResource SetupEndpointCloudflare}" Tag="cloudflare"/>
                                            <ComboBoxItem Content="{DynamicResource SetupEndpointAliyun}" Tag="aliyun"/>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource SetupEndpointHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <!-- Kept off-screen for legacy config normalization/source compatibility. -->
                                        <TextBox x:Name="SettMasterUrl" Visibility="Collapsed"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupClientId}"/>
                                        <TextBox Style="{StaticResource InputTextBox}" x:Name="SettClientId" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupAgentToken}"/>
                                        <PasswordBox x:Name="SettAgentToken" Padding="10,8" FontSize="13" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="SettSaveInfoCheckBox" Content="{DynamicResource SetupSaveInfo}"
                                                  IsChecked="True" Margin="0,0,0,8"/>

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsPollInterval}"/>
                                        <TextBox Style="{StaticResource InputTextBox}" x:Name="SettPollInterval" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsHealthInterval}"/>
                                        <TextBox Style="{StaticResource InputTextBox}" x:Name="SettHealthInterval" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsEgressInterface}"/>
                                        <ComboBox x:Name="SettEgressInterface" DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id" Margin="0,0,0,4"
                                                  AutomationProperties.Name="Outbound network interface"/>
                                        <TextBlock Text="{DynamicResource SettingsEgressInterfaceHint}" Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsLogLevel}"/>
                                        <ComboBox x:Name="SettLogLevel" Margin="0,0,0,4"
                                                  AutomationProperties.Name="Log level">
                                            <ComboBoxItem Content="{DynamicResource SettingsLogLevelWarning}" Tag="WARNING"/>
                                            <ComboBoxItem Content="{DynamicResource SettingsLogLevelCritical}" Tag="CRITICAL"/>
                                            <ComboBoxItem Content="{DynamicResource SettingsLogLevelDebug}" Tag="DEBUG"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SettingsGeneral}" FontSize="15"
                                                   FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsLanguage}"/>
                                        <ComboBox x:Name="SettLanguage" SelectedIndex="0" Margin="0,0,0,10" Width="240" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="English" Tag="en-US"/>
                                            <ComboBoxItem Content="中文" Tag="zh-CN"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsTheme}"/>
                                        <ComboBox x:Name="SettTheme" Margin="0,0,0,12" Width="240" HorizontalAlignment="Left"
                                                  SelectionChanged="OnThemeSelectionChanged" AutomationProperties.Name="Theme">
                                            <ComboBoxItem Content="{DynamicResource ThemeSystem}" Tag="System"/>
                                            <ComboBoxItem Content="{DynamicResource ThemeLight}" Tag="Light"/>
                                            <ComboBoxItem Content="{DynamicResource ThemeDark}" Tag="Dark"/>
                                        </ComboBox>
                                        <CheckBox x:Name="SettAutoStart" Content="{DynamicResource SettingsAutoStart}" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="SettMinimizeTray" Content="{DynamicResource SettingsMinimizeToTray}" IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TonalButton}" Content="{DynamicResource ActionCheckUpdates}"
                                                Click="OnCheckForUpdates_Click" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SettingsAbout}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding AppVersionText}" FontSize="13"/>
                                            <TextBlock Text="{Binding UpdateCheckStatus}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionSave}"
                                        Click="OnSaveSettings_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <TextBlock x:Name="SettingsStatus" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- Start / stop the local connection (selected service + its node) with a running timer. -->
                <Button x:Name="CoreToggleButton" Style="{StaticResource FabButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,28"
                        Click="OnCoreToggle_Click" AutomationProperties.Name="Start or stop the connection">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CoreToggleGlyph" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center"
                                   Text="&#xE768;" Margin="0,0,12,0"/>
                        <TextBlock x:Name="CoreToggleText" VerticalAlignment="Center" Text="{DynamicResource FabStart}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
