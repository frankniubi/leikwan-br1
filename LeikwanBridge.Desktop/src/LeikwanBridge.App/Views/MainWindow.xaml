<Window x:Class="LeikwanBridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeikwanBridge.App.ViewModels"
        xmlns:conv="clr-namespace:LeikwanBridge.App.Converters"
        Title="{DynamicResource AppTitle}" Height="800" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="/LeikwanBridge.App;component/Resources/Icons/leikwan-host.ico"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToStatusBrushConverter x:Key="StatusBrush"/>
        <conv:BoolToStatusTextConverter x:Key="StatusText"/>
        <conv:ModeToColorConverter x:Key="ModeColor"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ProxyIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Setup Wizard Overlay -->
        <Grid x:Name="SetupOverlay" Visibility="{Binding ShowSetupWizard, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100" Background="#E0F8FAFC">
            <Border Style="{StaticResource CardBorder}" MaxWidth="450" MaxHeight="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="8">
                    <TextBlock Text="{DynamicResource SetupTitle}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SetupSubtitle}" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupEndpoint}"/>
                    <ComboBox x:Name="SetupEndpointCombo" SelectedIndex="0" Margin="0,0,0,4"
                              SelectionChanged="OnEndpointSelectionChanged"
                              AutomationProperties.Name="Connection site">
                        <ComboBoxItem Content="{DynamicResource SetupEndpointCloudflare}" Tag="cloudflare"/>
                        <ComboBoxItem Content="{DynamicResource SetupEndpointAliyun}" Tag="aliyun"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource SetupEndpointHint}" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <!-- Kept off-screen for legacy config normalization/source compatibility. -->
                    <TextBox x:Name="TxtMasterUrl" Visibility="Collapsed"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupClientId}"/>
                    <TextBox Style="{StaticResource InputTextBox}" x:Name="TxtClientId" Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupAgentToken}"/>
                    <PasswordBox x:Name="TxtAgentToken" Padding="10,8" FontSize="13" Margin="0,0,0,20"/>

                    <CheckBox x:Name="SetupSaveInfoCheckBox" Content="{DynamicResource SetupSaveInfo}"
                              IsChecked="True" Margin="0,0,0,12"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionConnect}"
                            Click="OnConnect_Click" HorizontalAlignment="Stretch"/>

                    <TextBlock x:Name="SetupStatus" Margin="0,12,0,0" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="UpdatePromptOverlay"
              Visibility="{Binding IsUpdateOverlayVisible, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="102"
              Background="#D0F8FAFC">
            <Border Style="{StaticResource CardBorder}" MaxWidth="520" MaxHeight="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="8">
                    <TextBlock Text="{DynamicResource UpdateAvailableTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"
                               Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock x:Name="UpdateVersionText"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"
                               Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>

                    <!-- Update progress: phase + percent + message -->
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding IsUpdateInProgress, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding UpdatePhaseText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdatePercent}" Height="8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding UpdateProgressMessage}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Failure details + retry -->
                    <TextBlock Text="{DynamicResource UpdateFailedTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"
                               Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding UpdateErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionRetryUpdate}"
                            Command="{Binding RetryUpdateCommand}" Margin="0,0,0,8"
                            Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionDismiss}"
                            Command="{Binding DismissUpdateErrorCommand}"
                            Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionInstallNow}"
                            Click="OnInstallUpdateNow_Click" Margin="0,0,0,8"
                            Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionDeferUpdate}"
                            Click="OnDeferUpdateUntilRestart_Click"
                            Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Layout -->
        <Grid Visibility="{Binding ShowSetupWizard, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <DockPanel>
                    <!-- Logo / Title -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
                        <TextBlock Text="{DynamicResource AppTitle}" FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                     Fill="{Binding IsConnected, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="12"
                                       Foreground="{StaticResource SidebarTextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SignedInEmail}" FontSize="11"
                                   Foreground="{StaticResource SidebarTextBrush}" Margin="0,10,0,0"
                                   Visibility="{Binding HasSignedInEmail, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource ProxyConvergenceHint}" FontSize="11"
                                   Foreground="{StaticResource SidebarTextBrush}" TextWrapping="Wrap"
                                   MaxWidth="188" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Nav Buttons -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,0">
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavDashboard}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavForwards}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Forwards"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavProxy}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Proxy"
                                AutomationProperties.Name="Local proxy"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavLog}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Log"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavSettings}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
                    </StackPanel>

                    <!-- Bottom Actions -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,16" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource ActionCheckUpdates}"
                                Click="OnCheckForUpdates_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource ActionSignOut}"
                                Click="OnSignOut_Click"/>
                        <Button x:Name="SidebarStartAllButton" Style="{StaticResource NavButton}" Content="{DynamicResource ActionStartAll}" Visibility="Visible"
                                Command="{Binding StartAllCommand}"/>
                        <Button x:Name="SidebarStopAllButton" Style="{StaticResource NavButton}" Content="{DynamicResource ActionStopAll}" Visibility="Visible"
                                Command="{Binding StopAllForwardsCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="24,16">
                <!-- Dashboard View -->
                <ScrollViewer x:Name="DashboardPanel"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashSummaryTitle}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource DashSummarySubtitle}" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" MaxWidth="520"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource ModeBadge}"
                                        Background="{Binding IsConnected, Converter={StaticResource StatusBrush}}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                                               Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashActiveForwards}"/>
                                    <TextBlock Text="{Binding ActiveForwardCount}" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashBytesIn}"/>
                                    <TextBlock Text="{Binding TotalBytesIn}" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashBytesOut}"/>
                                    <TextBlock Text="{Binding TotalBytesOut}" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashLastSync}"/>
                                    <TextBlock Text="{Binding LastSyncTime}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashQuickActions}"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStartAll}"
                                            Command="{Binding StartAllCommand}" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{DynamicResource ActionStopAll}"
                                            Command="{Binding StopAllForwardsCommand}" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource DashOpenLogs}"
                                            Command="{Binding NavigateToCommand}" CommandParameter="Log" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource DashOpenSettings}"
                                            Command="{Binding NavigateToCommand}" CommandParameter="Settings" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashForwardControls}" DockPanel.Dock="Left" Margin="0"/>
                                    <TextBlock Text="{Binding ForwardCount, StringFormat={}{0} forwards shown}"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </DockPanel>
                                <TextBlock Text="{DynamicResource DashMethodSummary}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>
                                <Border x:Name="DashboardForwardLoading" Background="#F7FAF9" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12"
                                        Visibility="{Binding IsLoadingForwards, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ProgressBar Width="220" Height="6" IsIndeterminate="True"/>
                                        <TextBlock Text="{DynamicResource DashForwardLoading}" Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{DynamicResource DashNoVisibleForwards}" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ForwardCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Forwards}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingForwards}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardBorder}" Width="300" Cursor="Hand"
                                                    MouseLeftButtonUp="OnForwardCardClick">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                            <Ellipse Style="{StaticResource StatusDot}"
                                                                     Fill="{Binding Summary.CanStop, Converter={StaticResource StatusBrush}}"/>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextWrapping="Wrap" MaxWidth="205"/>
                                                        </StackPanel>
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource ModeBadge}"
                                                                Background="{StaticResource PrimaryBrush}"
                                                                HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Summary.QualityText}" FontSize="11"
                                                                       Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DockPanel>

                                                    <!-- Native outbound rules ship configuration only: no start/stop control. -->
                                                    <TextBlock Text="{DynamicResource ForwardNativeOutboundRule}" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                                               TextWrapping="Wrap" Margin="0,0,0,4"
                                                               Visibility="{Binding Summary.IsNativeOutboundRule, Converter={StaticResource BoolToVis}}"/>

                                                    <TextBlock Text="{Binding Summary.Lifecycle}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Summary.FriendlyMessage}" FontSize="12"
                                                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                                               Margin="0,0,0,8"/>

                                                    <WrapPanel HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStop}" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.StopForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding Summary.CanStop, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStart}" Margin="0,0,0,6"
                                                                Command="{Binding DataContext.StartForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding Summary.CanStart, Converter={StaticResource BoolToVis}}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                                        Visibility="{Binding SelectedForward, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="Forward Details" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Forward"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="{Binding SelectedForward.DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <!-- Native outbound rules ship configuration only: no start/stop control. -->
                                                <TextBlock Text="{DynamicResource ForwardNativeOutboundRule}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding SelectedForward.Summary.IsNativeOutboundRule, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedForward.Summary.Lifecycle}" FontSize="14"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Quality"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedForward.Summary.QualityText}" FontSize="14"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Message"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedForward.Summary.FriendlyMessage}" FontSize="14" TextWrapping="Wrap"/>
                                        </Grid>

                                        <WrapPanel HorizontalAlignment="Right">
                                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStop}" Margin="0,0,6,6"
                                                    Command="{Binding StopForwardCommand}"
                                                    CommandParameter="{Binding SelectedForward}"
                                                    Visibility="{Binding SelectedForward.Summary.CanStop, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStart}" Margin="0,0,0,6"
                                                    Command="{Binding StartForwardCommand}"
                                                    CommandParameter="{Binding SelectedForward}"
                                                    Visibility="{Binding SelectedForward.Summary.CanStart, Converter={StaticResource BoolToVis}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashRecentLogs}" DockPanel.Dock="Left" Margin="0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource DashOpenLogs}"
                                            Command="{Binding NavigateToCommand}" CommandParameter="Log"
                                            DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="11"
                                         MaxHeight="180" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Forward pairing view: configuration only, never starts a runtime connection. -->
                <ScrollViewer x:Name="ForwardPairingPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#E8F5F2" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource ForwardPairingTitle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{DynamicResource ForwardPairingHint}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource ForwardPairingTitle}" DockPanel.Dock="Left" Margin="0"/>
                                </DockPanel>
                                <TextBlock Text="{DynamicResource ForwardPairingListHint}" Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="ForwardPairingRows" ItemsSource="{Binding ProxyForwardRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FAFCFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="260"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{DynamicResource ProxyRouteListenPort}" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding ListenerEndpoint}" FontFamily="Consolas" FontSize="12"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRowNode}"/>
                                                        <ComboBox ItemsSource="{Binding Profiles}" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}"
                                                                  SelectionChanged="OnProxyRowProfileSelectionChanged"
                                                                  AutomationProperties.Name="{Binding Title}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ForwardPairingStatus" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,2,0,10"/>
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ForwardPairingSave}"
                                            Click="OnSaveForwardPairings_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ForwardPairingOpenProxy}"
                                            Command="{Binding NavigateToCommand}" CommandParameter="Proxy"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ForwardPairingNodeSection" Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FAFCFB" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,0" Padding="0,0,14,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource ProxyMyNodes}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource ProxyIconButton}" Content="&#xE710;"
                                                    Click="OnPairingNew_Click" AutomationProperties.Name="New proxy profile"/>
                                        </Grid>
                                        <ListBox x:Name="ForwardPairingProfileList" Grid.Row="1" ItemsSource="{Binding ProxyProfiles}"
                                                 SelectedValuePath="Id" SelectionChanged="OnPairingProfileSelectionChanged"
                                                 BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,8">
                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Protocol}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource ProxyIconButton}" Content="&#xE70F;" Click="OnPairingEdit_Click"
                                                    ToolTip="{DynamicResource ProxyEdit}" AutomationProperties.Name="Edit saved node" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource ProxyIconButton}" Content="&#xE74D;" Click="OnPairingDelete_Click"
