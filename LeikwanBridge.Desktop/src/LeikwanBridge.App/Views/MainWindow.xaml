<Window x:Class="LeikwanBridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeikwanBridge.App.ViewModels"
        xmlns:conv="clr-namespace:LeikwanBridge.App.Converters"
        Title="{DynamicResource AppTitle}" Height="700" Width="1050"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="/LeikwanBridge.App;component/Resources/Icons/leikwan-host.ico"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToStatusBrushConverter x:Key="StatusBrush"/>
        <conv:BoolToStatusTextConverter x:Key="StatusText"/>
        <conv:ModeToColorConverter x:Key="ModeColor"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- Setup Wizard Overlay -->
        <Grid x:Name="SetupOverlay" Visibility="{Binding ShowSetupWizard, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100" Background="#E0F8FAFC">
            <Border Style="{StaticResource CardBorder}" MaxWidth="450" MaxHeight="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="8">
                    <TextBlock Text="{DynamicResource SetupTitle}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SetupSubtitle}" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupMasterUrl}"/>
                    <TextBox Style="{StaticResource InputTextBox}" x:Name="TxtMasterUrl"
                             Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupClientId}"/>
                    <TextBox Style="{StaticResource InputTextBox}" x:Name="TxtClientId" Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupAgentToken}"/>
                    <PasswordBox x:Name="TxtAgentToken" Padding="10,8" FontSize="13" Margin="0,0,0,20"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionConnect}"
                            Click="OnConnect_Click" HorizontalAlignment="Stretch"/>

                    <TextBlock x:Name="SetupStatus" Margin="0,12,0,0" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="UpdatePromptOverlay"
              Visibility="{Binding ShowUpdatePrompt, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="102"
              Background="#D0F8FAFC">
            <Border Style="{StaticResource CardBorder}" MaxWidth="520" MaxHeight="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="8">
                    <TextBlock Text="{DynamicResource UpdateAvailableTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="UpdateVersionText"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionInstallNow}"
                            Click="OnInstallUpdateNow_Click" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionDeferUpdate}"
                            Click="OnDeferUpdateUntilRestart_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Layout -->
        <Grid Visibility="{Binding ShowSetupWizard, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <DockPanel>
                    <!-- Logo / Title -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
                        <TextBlock Text="{DynamicResource AppTitle}" FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                     Fill="{Binding IsConnected, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="12"
                                       Foreground="{StaticResource SidebarTextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SignedInEmail}" FontSize="11"
                                   Foreground="{StaticResource SidebarTextBrush}" Margin="0,10,0,0"
                                   Visibility="{Binding HasSignedInEmail, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource ProxyConvergenceHint}" FontSize="11"
                                   Foreground="{StaticResource SidebarTextBrush}" TextWrapping="Wrap"
                                   MaxWidth="188" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Nav Buttons -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,0">
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavDashboard}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavForwards}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Forwards"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavProxy}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Proxy"
                                AutomationProperties.Name="Local proxy"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavLog}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Log"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavSettings}"
                                Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
                    </StackPanel>

                    <!-- Bottom Actions -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,16" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource ActionCheckUpdates}"
                                Click="OnCheckForUpdates_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource ActionSignOut}"
                                Click="OnSignOut_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource ActionStartAll}"
                                Command="{Binding StartAllCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="{DynamicResource ActionStopAll}"
                                Command="{Binding StopAllForwardsCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="24,16">
                <!-- Dashboard View -->
                <ScrollViewer x:Name="DashboardPanel"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashSummaryTitle}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource DashSummarySubtitle}" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" MaxWidth="520"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource ModeBadge}"
                                        Background="{Binding IsConnected, Converter={StaticResource StatusBrush}}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                                               Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashActiveForwards}"/>
                                    <TextBlock Text="{Binding ActiveForwardCount}" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashBytesIn}"/>
                                    <TextBlock Text="{Binding TotalBytesIn}" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashBytesOut}"/>
                                    <TextBlock Text="{Binding TotalBytesOut}" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource DashLastSync}"/>
                                    <TextBlock Text="{Binding LastSyncTime}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashQuickActions}"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStartAll}"
                                            Command="{Binding StartAllCommand}" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource DangerButton}" Content="{DynamicResource ActionStopAll}"
                                            Command="{Binding StopAllForwardsCommand}" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource DashOpenLogs}"
                                            Command="{Binding NavigateToCommand}" CommandParameter="Log" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource DashOpenSettings}"
                                            Command="{Binding NavigateToCommand}" CommandParameter="Settings" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashForwardControls}" DockPanel.Dock="Left" Margin="0"/>
                                    <TextBlock Text="{Binding ForwardCount, StringFormat={}{0} forwards shown}"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </DockPanel>
                                <TextBlock Text="{DynamicResource DashMethodSummary}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource DashNoVisibleForwards}" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ForwardCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Forwards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardBorder}" Width="300" Cursor="Hand"
                                                    MouseLeftButtonUp="OnForwardCardClick">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                            <Ellipse Style="{StaticResource StatusDot}"
                                                                     Fill="{Binding Summary.CanStop, Converter={StaticResource StatusBrush}}"/>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextWrapping="Wrap" MaxWidth="205"/>
                                                        </StackPanel>
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource ModeBadge}"
                                                                Background="{StaticResource PrimaryBrush}"
                                                                HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Summary.QualityText}" FontSize="11"
                                                                       Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding Summary.Lifecycle}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Summary.FriendlyMessage}" FontSize="12"
                                                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                                               Margin="0,0,0,8"/>

                                                    <WrapPanel HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStop}" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.StopForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding Summary.CanStop, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStart}" Margin="0,0,0,6"
                                                                Command="{Binding DataContext.StartForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding Summary.CanStart, Converter={StaticResource BoolToVis}}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                                        Visibility="{Binding SelectedForward, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="Forward Details" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Forward"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedForward.DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedForward.Summary.Lifecycle}" FontSize="14"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Quality"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedForward.Summary.QualityText}" FontSize="14"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Message"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedForward.Summary.FriendlyMessage}" FontSize="14" TextWrapping="Wrap"/>
                                        </Grid>

                                        <WrapPanel HorizontalAlignment="Right">
                                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ActionStop}" Margin="0,0,6,6"
                                                    Command="{Binding StopForwardCommand}"
                                                    CommandParameter="{Binding SelectedForward}"
                                                    Visibility="{Binding SelectedForward.Summary.CanStop, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionStart}" Margin="0,0,0,6"
                                                    Command="{Binding StartForwardCommand}"
                                                    CommandParameter="{Binding SelectedForward}"
                                                    Visibility="{Binding SelectedForward.Summary.CanStart, Converter={StaticResource BoolToVis}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource DashRecentLogs}" DockPanel.Dock="Left" Margin="0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource DashOpenLogs}"
                                            Command="{Binding NavigateToCommand}" CommandParameter="Log"
                                            DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="11"
                                         MaxHeight="180" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Local proxy view -->
                <ScrollViewer x:Name="ProxyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource ProxyTitle}"
                                       DockPanel.Dock="Left"/>
                            <Button x:Name="ProxyNewButton" Style="{StaticResource GhostButton}"
                                    Content="{DynamicResource ProxyNew}" DockPanel.Dock="Right"
                                    Click="OnProxyNew_Click" AutomationProperties.Name="New proxy profile"/>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource ProxySubtitle}" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource ProxyElevationHint}" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyProfiles}"/>
                                    <ListBox x:Name="ProxyProfileList" ItemsSource="{Binding ProxyProfiles}"
                                             MinHeight="120" MaxHeight="360"
                                             SelectionChanged="OnProxyProfileSelectionChanged"
                                             AutomationProperties.Name="Proxy profiles">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DisplayEndpoint}" Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyNew}"
                                            Click="OnProxyNew_Click" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyImport}"/>
                                        <DockPanel>
                                            <TextBox x:Name="ProxyImportUri" Style="{StaticResource InputTextBox}"
                                                     DockPanel.Dock="Left" Margin="0,0,8,0"
                                                     AutomationProperties.Name="Proxy URI"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ProxyImport}"
                                                    Click="OnProxyImport_Click" AutomationProperties.Name="Import proxy URI"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                         <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyProtocol}"/>
                                                <ComboBox ItemsSource="{Binding ProxyEditor.ProtocolOptions}"
                                                          SelectedItem="{Binding ProxyEditor.Protocol, Mode=TwoWay}"
                                                          AutomationProperties.Name="Proxy protocol"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyMode}"/>
                                                <ComboBox x:Name="ProxyModeCombo" SelectedIndex="0"
                                                          SelectionChanged="OnProxyModeSelectionChanged"
                                                          AutomationProperties.Name="Proxy mode">
                                                    <ComboBoxItem Content="{DynamicResource ProxyModeHttp}" Tag="Http"/>
                                                    <ComboBoxItem Content="{DynamicResource ProxyModeTun}" Tag="Tun"/>
                                                    <ComboBoxItem Content="{DynamicResource ProxyModeProcess}" Tag="Process"/>
                                                </ComboBox>
                                             </StackPanel>
                                         </Grid>

                                         <CheckBox x:Name="ProxyBypassChinaCheckBox"
                                                   Content="{DynamicResource ProxyBypassChinaMainland}"
                                                   IsChecked="{Binding Config.ProxyBypassChinaMainland, Mode=TwoWay}"
                                                   Margin="0,0,0,10"
                                                   AutomationProperties.Name="Bypass mainland China IPs"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyDnsMode}"/>
                                                <ComboBox x:Name="ProxyDnsModeCombo"
                                                          SelectionChanged="OnProxyDnsModeSelectionChanged"
                                                          AutomationProperties.Name="Proxy DNS mode">
                                                    <ComboBoxItem Content="{DynamicResource ProxyDnsRemote}" Tag="Remote"/>
                                                    <ComboBoxItem Content="{DynamicResource ProxyDnsCustom}" Tag="Custom"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel x:Name="ProxyDnsServersPanel" Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyDnsServers}"/>
                                                <TextBox x:Name="ProxyDnsServersText"
                                                         Style="{StaticResource InputTextBox}"
                                                         TextChanged="OnProxyDnsServersTextChanged"
                                                         AutomationProperties.Name="Custom DNS servers"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource ProxyDnsHint}" Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyLocalListenPort}"/>
                                                <ComboBox x:Name="ProxyLocalListenPortCombo"
                                                          ItemsSource="{Binding ProxyEditor.LocalListenPortOptions}"
                                                          IsEditable="True"
                                                          AutomationProperties.Name="Local proxy listen port"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource ProxyLocalListenPortHint}"
                                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                                       VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyName}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Name, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Proxy profile name"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServer}"/>
                                                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Server, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Proxy server"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPort}"/>
                                                <ComboBox ItemsSource="{Binding ProxyEditor.PortOptions}" IsEditable="True"
                                                          Text="{Binding ProxyEditor.PortText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Proxy port"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="ProxySsFields">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProxyEditor.IsShadowsocks}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyMethod}"/>
                                            <ComboBox ItemsSource="{Binding ProxyEditor.ShadowsocksMethodOptions}"
                                                      SelectedItem="{Binding ProxyEditor.Method, Mode=TwoWay}"
                                                      Margin="0,0,0,8" AutomationProperties.Name="Shadowsocks cipher"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPassword}"/>
                                            <PasswordBox x:Name="ProxyPassword" Padding="10,8" FontSize="13" Margin="0,0,0,8"
                                                         AutomationProperties.Name="Proxy password"/>
                                            <CheckBox Content="{DynamicResource ProxyUdpOverTcp}" IsChecked="{Binding ProxyEditor.UdpOverTcp, Mode=TwoWay}"
                                                      Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <StackPanel x:Name="ProxyVlessFields">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProxyEditor.IsVless}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyUuid}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Uuid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyTransport}"/>
                                                    <ComboBox ItemsSource="{Binding ProxyEditor.VlessTransportOptions}"
                                                              SelectedItem="{Binding ProxyEditor.Transport, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyFlow}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Flow, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyHost}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Host, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyPath}"/>
                                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Path, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServiceName}"
                                                       Visibility="{Binding ProxyEditor.IsVlessGrpc, Converter={StaticResource BoolToVis}}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.ServiceName, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding ProxyEditor.IsVlessGrpc, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyServerName}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyFingerprint}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.Fingerprint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRealityKey}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.RealityPublicKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyRealityShortId}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding ProxyEditor.RealityShortId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource ProxyTls}" IsChecked="{Binding ProxyEditor.Tls, Mode=TwoWay}" Margin="0,0,16,0"/>
                                                <CheckBox Content="{DynamicResource ProxyAllowInsecure}" IsChecked="{Binding ProxyEditor.AllowInsecure, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ProxyGameCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyGame}" DockPanel.Dock="Left"/>
                                            <WrapPanel DockPanel.Dock="Right">
                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyAddGame}"
                                                        Click="OnProxyAddGame_Click" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyImportNetchModes}"
                                                        Click="OnProxyImportNetchModes_Click" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyRefreshGames}"
                                                        Click="OnProxyRefreshGames_Click"/>
                                            </WrapPanel>
                                        </DockPanel>
                                        <TextBlock Text="{DynamicResource ProxyGameHint}" Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="ProxyGameCombo" ItemsSource="{Binding ProxyGameOptions}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedProxyGameId, Mode=OneWay}"
                                                  SelectionChanged="OnProxyGameSelectionChanged"
                                                  AutomationProperties.Name="Game to proxy">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}"
                                                                   HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                         </ComboBox.ItemTemplate>
                                     </ComboBox>
                                         <Border Background="#E0F2FE" BorderBrush="#7DD3FC" BorderThickness="1"
                                                 CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                             <DockPanel LastChildFill="True">
                                                 <TextBlock Text="{DynamicResource ProxyActiveGame}" FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextBrush}" Margin="0,0,8,0"
                                                            DockPanel.Dock="Left"/>
                                                 <TextBlock Text="{Binding SelectedProxyGameDisplayName}" FontWeight="Bold"
                                                            Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                         </Border>
                                 </StackPanel>
                             </Border>

                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyDelete}"
                                            Click="OnProxyDelete_Click" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxySave}"
                                            Click="OnProxySave_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="ProxyStopButton" Style="{StaticResource DangerButton}" Content="{DynamicResource ProxyStop}"
                                            Click="OnProxyStop_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="ProxyTestUdpButton" Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyTestUdp}"
                                            Click="OnProxyTestUdp_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="ProxyStartButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource ProxyStart}"
                                            Click="OnProxyStart_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <Border x:Name="ProxyStatusBanner" Padding="12" Margin="0,4,0,0"
                                        CornerRadius="6" BorderThickness="1"
                                        Background="#EFF6FF" BorderBrush="{StaticResource PrimaryBrush}">
                                    <StackPanel>
                                        <TextBlock x:Name="ProxyStatusTitle" Text="{DynamicResource ProxyDisconnected}"
                                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="ProxyStatusText" Text="{DynamicResource ProxyReady}"
                                                   FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Log View -->
                <DockPanel x:Name="LogPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource NavLog}"
                                   DockPanel.Dock="Left"/>
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource LogClear}"
                                Command="{Binding ClearLogCommand}" DockPanel.Dock="Right"
                                HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="8">
                        <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="11"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 x:Name="LogListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- Settings View -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource NavSettings}"/>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsConnection}" FontSize="15"
                                           FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupMasterUrl}"/>
                                <TextBox Style="{StaticResource InputTextBox}" x:Name="SettMasterUrl" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupClientId}"/>
                                <TextBox Style="{StaticResource InputTextBox}" x:Name="SettClientId" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SetupAgentToken}"/>
                                <PasswordBox x:Name="SettAgentToken" Padding="10,8" FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsPollInterval}"/>
                                <TextBox Style="{StaticResource InputTextBox}" x:Name="SettPollInterval" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource SettingsHealthInterval}"/>
                                <TextBox Style="{StaticResource InputTextBox}" x:Name="SettHealthInterval" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLanguage}" FontSize="15"
                                           FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <ComboBox x:Name="SettLanguage" SelectedIndex="0" Margin="0,0,0,8">
                                    <ComboBoxItem Content="English" Tag="en-US"/>
                                    <ComboBoxItem Content="中文" Tag="zh-CN"/>
                                </ComboBox>
                                <CheckBox x:Name="SettAutoStart" Content="{DynamicResource SettingsAutoStart}" Margin="0,0,0,4"/>
                                <CheckBox x:Name="SettMinimizeTray" Content="{DynamicResource SettingsMinimizeToTray}" IsChecked="True"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ActionSave}"
                                Click="OnSaveSettings_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SettingsStatus" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
