<Window x:Class="LeikwanBridge.App.Views.ProxyGameAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProxyGameAddTitle}"
        Width="500"
        Height="330"
        MinWidth="440"
        MinHeight="300"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource ProxyGameAddTitle}" FontSize="20"
                   FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource ProxyGameAddHint}" Margin="0,6,0,18"
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyGameAddMode}"/>
            <ComboBox x:Name="SourceModeCombo" Grid.Column="1" SelectedIndex="0"
                      SelectionChanged="OnSourceModeSelectionChanged"
                      AutomationProperties.Name="Game source mode">
                <ComboBoxItem Content="{DynamicResource ProxyGameAddSingle}" Tag="Single"/>
                <ComboBoxItem Content="{DynamicResource ProxyGameAddFolder}" Tag="Folder"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedPathText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                       Text="{DynamicResource ProxyGameNoPath}"/>
            <Button x:Name="ChoosePathButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                    Content="{DynamicResource ProxyGameChooseFile}" Click="OnChoosePath_Click"
                    Margin="12,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ProxyGameDisplayName}"/>
            <TextBox x:Name="DisplayNameText" Style="{StaticResource InputTextBox}"
                     ToolTip="{DynamicResource ProxyGameDisplayNameHint}"
                     AutomationProperties.Name="Game display name"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource ProxyGameCancel}"
                    Click="OnCancel_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource ProxyGameConfirm}"
                    Click="OnConfirm_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
