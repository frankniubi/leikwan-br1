<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- App -->
    <system:String x:Key="AppTitle">利群會聚</system:String>
    <system:String x:Key="AppVersion">v1.0.0</system:String>

    <!-- Navigation -->
    <system:String x:Key="NavDashboard">仪表盘</system:String>
    <system:String x:Key="NavForwards">转发管理</system:String>
    <system:String x:Key="NavLog">日志</system:String>
    <system:String x:Key="NavSettings">设置</system:String>

    <!-- Dashboard -->
    <system:String x:Key="DashConnected">已连接</system:String>
    <system:String x:Key="DashDisconnected">未连接</system:String>
    <system:String x:Key="DashLastSync">上次同步：</system:String>
    <system:String x:Key="DashActiveForwards">活跃转发</system:String>
    <system:String x:Key="DashBytesIn">流入字节</system:String>
    <system:String x:Key="DashBytesOut">流出字节</system:String>
    <system:String x:Key="DashUptime">运行时间</system:String>

    <!-- Forward Card -->
    <system:String x:Key="FwdId">转发 ID</system:String>
    <system:String x:Key="FwdMode">模式</system:String>
    <system:String x:Key="FwdListenPort">监听端口</system:String>
    <system:String x:Key="FwdTarget">目标</system:String>
    <system:String x:Key="FwdStatus">状态</system:String>
    <system:String x:Key="FwdRunning">运行中</system:String>
    <system:String x:Key="FwdStopped">已停止</system:String>
    <system:String x:Key="FwdError">错误</system:String>
    <system:String x:Key="FwdEndpoints">端点</system:String>
    <system:String x:Key="FwdTransport">传输协议</system:String>

    <!-- Actions -->
    <system:String x:Key="ActionStart">启动</system:String>
    <system:String x:Key="ActionStop">停止</system:String>
    <system:String x:Key="ActionRestart">重启</system:String>
    <system:String x:Key="ActionStartAll">全部启动</system:String>
    <system:String x:Key="ActionStopAll">全部停止</system:String>
    <system:String x:Key="ActionSave">保存</system:String>
    <system:String x:Key="ActionCancel">取消</system:String>
    <system:String x:Key="ActionConnect">连接</system:String>
    <system:String x:Key="ActionTestConnection">测试连接</system:String>

    <!-- Setup Wizard -->
    <system:String x:Key="SetupTitle">欢迎使用利群會聚</system:String>
    <system:String x:Key="SetupSubtitle">配置连接信息以开始使用</system:String>
    <system:String x:Key="SetupMasterUrl">主控面板地址</system:String>
    <system:String x:Key="SetupClientId">客户端 ID</system:String>
    <system:String x:Key="SetupAgentToken">认证令牌</system:String>
    <system:String x:Key="SetupConnecting">连接中...</system:String>
    <system:String x:Key="SetupSuccess">连接成功！</system:String>
    <system:String x:Key="SetupFailed">连接失败，请检查设置。</system:String>

    <!-- Settings -->
    <system:String x:Key="SettingsConnection">连接设置</system:String>
    <system:String x:Key="SettingsPollInterval">轮询间隔（秒）</system:String>
    <system:String x:Key="SettingsHealthInterval">健康检查间隔（秒）</system:String>
    <system:String x:Key="SettingsLogLevel">日志级别</system:String>
    <system:String x:Key="SettingsAutoStart">开机自启</system:String>
    <system:String x:Key="SettingsMinimizeToTray">最小化到系统托盘</system:String>
    <system:String x:Key="SettingsBinaries">二进制路径</system:String>
    <system:String x:Key="SettingsBondBin">Bond 程序</system:String>
    <system:String x:Key="SettingsWstunnelBin">Wstunnel 程序</system:String>
    <system:String x:Key="SettingsWgBin">WireGuard 程序</system:String>
    <system:String x:Key="SettingsLanguage">语言</system:String>
    <system:String x:Key="SettingsSaved">设置已保存。</system:String>

    <!-- Log -->
    <system:String x:Key="LogClear">清除</system:String>
    <system:String x:Key="LogExport">导出</system:String>
    <system:String x:Key="LogFilter">筛选...</system:String>

    <!-- Tray -->
    <system:String x:Key="TrayShow">显示窗口</system:String>
    <system:String x:Key="TrayExit">退出</system:String>
    <system:String x:Key="TrayForwardsActive">{0} 个转发运行中</system:String>

    <!-- Mode Labels -->
    <system:String x:Key="ModeMptcpFallback">MPTCP（Bond 回退）</system:String>
    <system:String x:Key="ModeMptcp">MPTCP</system:String>
    <system:String x:Key="ModeBond">Bond 聚合</system:String>
    <system:String x:Key="ModeRace">Race 竞速</system:String>
    <system:String x:Key="ModeSingle">单路径</system:String>
</ResourceDictionary>
