[Unit]
Description=Leikwan Task Cleanup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/www/wwwroot/v3.leikwanhost.com/leikwan-v3/master
ExecStart=/usr/bin/php /www/wwwroot/v3.leikwanhost.com/leikwan-v3/master/cli/cleanup-tasks.php --retention-days 7 --offline-minutes 60 --lease-timeout 10
