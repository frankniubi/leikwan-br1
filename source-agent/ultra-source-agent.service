[Unit]
Description=Ultra Source Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/ultra-source-agent.py --config /etc/ultra-source-agent.json
EnvironmentFile=-/etc/ultra-source-agent-login.env
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ultra-source-agent /opt/leigod

[Install]
WantedBy=multi-user.target
