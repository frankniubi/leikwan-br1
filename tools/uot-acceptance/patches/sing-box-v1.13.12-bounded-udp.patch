diff --git a/common/listener/listener_udp_backpressure_test.go b/common/listener/listener_udp_backpressure_test.go
new file mode 100644
index 0000000..c0adfe9
--- /dev/null
+++ b/common/listener/listener_udp_backpressure_test.go
@@ -0,0 +1,117 @@
+package listener
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"golang.org/x/sync/semaphore"
+)
+
+func testPacketWriter(ctx context.Context, capacity int) *packetWriter {
+	return &packetWriter{
+		ctx: ctx, logger: logger.NOP(),
+		packetOutbound:       make(chan *N.PacketBuffer, capacity),
+		packetOutboundClosed: make(chan struct{}),
+		packetOutboundBudget: semaphore.NewWeighted(8192),
+	}
+}
+
+func releaseTestPacket(w *packetWriter, packet *N.PacketBuffer) {
+	w.packetOutboundBudget.Release(int64(packet.Buffer.Len()))
+	packet.Buffer.Release()
+	N.PutPacketBuffer(packet)
+}
+
+func TestEnterpriseOutboundWaitsInsteadOfSilentlyDropping(t *testing.T) {
+	w := testPacketWriter(context.Background(), 1)
+	if err := w.WritePacket(buf.As(make([]byte, 1200)), M.Socksaddr{}); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- w.WritePacket(buf.As(make([]byte, 1201)), M.Socksaddr{}) }()
+	select {
+	case err := <-done:
+		t.Fatalf("full queue returned before admission: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	releaseTestPacket(w, <-w.packetOutbound)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	packet := <-w.packetOutbound
+	if packet.Buffer.Len() != 1201 {
+		t.Fatal("second datagram was lost")
+	}
+	releaseTestPacket(w, packet)
+	if w.packetQueueBlocked.Load() != 1 || w.packetQueueTimeout.Load() != 0 {
+		t.Fatal("incorrect admission counters")
+	}
+}
+
+func TestEnterpriseOutboundTimeoutIsExplicitAndReleasesBudget(t *testing.T) {
+	w := testPacketWriter(context.Background(), 0)
+	err := w.WritePacket(buf.As(make([]byte, 1200)), M.Socksaddr{})
+	if !errors.Is(err, context.DeadlineExceeded) || w.packetQueueTimeout.Load() != 1 {
+		t.Fatalf("silent timeout: %v", err)
+	}
+	if !w.packetOutboundBudget.TryAcquire(8192) {
+		t.Fatal("admission leaked byte reservation")
+	}
+}
+
+func TestEnterpriseOutboundCancellationAndClosedWriter(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	w := testPacketWriter(ctx, 0)
+	done := make(chan error, 1)
+	go func() { done <- w.WritePacket(buf.As(make([]byte, 1200)), M.Socksaddr{}) }()
+	cancel()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	if w.packetQueueTimeout.Load() != 0 {
+		t.Fatal("cancellation counted as timeout")
+	}
+	w.shutdown.Store(true)
+	if err := w.WritePacket(buf.As(make([]byte, 1200)), M.Socksaddr{}); !errors.Is(err, os.ErrClosed) {
+		t.Fatal(err)
+	}
+	if !w.packetOutboundBudget.TryAcquire(8192) {
+		t.Fatal("shutdown leaked byte reservation")
+	}
+}
+
+func TestEnterpriseOutboundByteCap(t *testing.T) {
+	w := testPacketWriter(context.Background(), 2)
+	if !w.packetOutboundBudget.TryAcquire(8192) {
+		t.Fatal("initial reserve")
+	}
+	err := w.WritePacket(buf.As(make([]byte, 1200)), M.Socksaddr{})
+	if !errors.Is(err, context.DeadlineExceeded) || len(w.packetOutbound) != 0 {
+		t.Fatalf("byte cap bypassed: %v", err)
+	}
+	w.packetOutboundBudget.Release(8192)
+	if !w.packetOutboundBudget.TryAcquire(8192) {
+		t.Fatal("failed admission changed reservation")
+	}
+}
+
+func TestEnterpriseOutboundShutdownDrainReleasesQueuedBytes(t *testing.T) {
+	w := testPacketWriter(context.Background(), 2)
+	for i := 0; i < 2; i++ {
+		if err := w.WritePacket(buf.As(make([]byte, 1200)), M.Socksaddr{}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	w.shutdown.Store(true)
+	(*Listener)(w).drainUDPOutbound()
+	if len(w.packetOutbound) != 0 || !w.packetOutboundBudget.TryAcquire(8192) {
+		t.Fatal("shutdown retained queued packets or byte reservations")
+	}
+}
